---
import Layout from '../../layouts/Layout.astro';
import demo from '../../../data/demo-report.json';

// Bar colour is derived from the real percentage. These must stay literal
// strings so Tailwind's scanner can see them — never build class names by
// concatenation.
const barColor = (pct) => (pct >= 80 ? 'bg-geo-500' : pct >= 50 ? 'bg-warn-500' : 'bg-danger-500');

const levelLabel = { Excellent: 'Excellent', Good: 'Good', Basic: 'Basic', Critical: 'Critical' };
const auditDate = new Date(demo.generatedAt).toISOString().slice(0, 10);
const botsAllowed = demo.aiBots.filter((b) => b.allowed).length;
const botsBlocked = demo.aiBots.filter((b) => !b.allowed);
const botsNote = botsBlocked.length > 0
  ? ` Blocked: ${botsBlocked.map((b) => b.bot).join(', ')}.`
  : ' None blocked.';
const piNote = demo.promptInjectionFlags > 0
  ? ` Prompt-injection scan: ${demo.promptInjectionFlags} flag(s), -${demo.promptInjectionPoints} pts.`
  : '';
---
<Layout title="Demo Report — GeoScore Sample Audit | GeoScore"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'GeoScore Demo Audit Report — Sample Website Analysis',
    description: 'See how GeoScore audits a real website. This demo report shows all 11 dimensions, 20 AI crawler checks, 85+ individual checks, and fix recommendations.',
    url: 'https://geoscore.help/report/demo/',
    author: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    datePublished: '2026-08-11',
    dateModified: '2026-08-11'
  }}
>
  <section class="max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-geo-500/10 text-geo-400 border border-geo-500/20 mb-4">
        Demo Report
      </div>
      <h1 class="text-4xl font-extrabold mb-3">Sample Audit Report</h1>
      <p class="text-gray-400 max-w-2xl mx-auto">See what a full GeoScore audit looks like — 11 dimensions, 20 AI crawler checks, 85+ individual checks, fix files, and recommendations.</p>
    </div>

    <!-- Report Header -->
    <div class="card p-6 mb-6">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <p class="text-sm text-gray-500">Audited URL</p>
          <p class="text-lg font-mono text-white">{demo.host}</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-extrabold text-geo-500">{demo.score}</div>
          <div class="text-xs font-semibold text-geo-400 mt-1">{levelLabel[demo.level] || demo.level}</div>
        </div>
        <div class="text-right">
          <p class="text-sm text-gray-500">Audit Date</p>
          <p class="text-sm text-gray-300">{auditDate}</p>
        </div>
      </div>
      <div class="mt-4 p-3 rounded-lg bg-white/5 text-sm text-gray-400">
        Score {demo.score}/100 ({levelLabel[demo.level] || demo.level}). {demo.dimensionsAboveSixty}/{demo.dimensionCount} dimensions above 60%. {demo.negativeSignals} negative signal(s) detected. {demo.promptInjectionFlags} prompt injection flag(s).
      </div>
      <p class="mt-3 text-xs text-gray-500">
        These are real results: GeoScore scanned {demo.host} on {auditDate}. Regenerate with <code class="font-mono text-gray-400">node tools/refresh-demo-report.mjs</code>.
      </p>
    </div>

    <!-- Dimension Breakdown -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Dimension Breakdown</h2>
      <div class="space-y-3">
        {demo.dimensions.map(d => (
          <div>
            <div class="flex items-center justify-between text-sm mb-1">
              <span class="text-gray-300">{d.label}</span>
              <span class="text-gray-500 font-mono">{d.score}/{d.maxScore} &middot; {d.pct}% <span class="text-gray-400">(weight &times;{d.weight})</span></span>
            </div>
            <div class="w-full h-2 rounded-full bg-gray-700/50 overflow-hidden">
              <div class={`h-full rounded-full ${barColor(d.pct)}`} style={`width:${d.pct}%`}></div>
            </div>
          </div>
        ))}
        <div class="pt-2 border-t border-gray-700/50">
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-300">Negative Signals</span>
            <span class="text-danger-400 font-mono">-{demo.negativeSignalPoints} pts</span>
          </div>
          <p class="text-xs text-gray-500 mt-1">
            {demo.negativeSignals} deduction(s) detected.{piNote}
          </p>
        </div>
      </div>
    </div>

    <!-- AI Crawler Details -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">AI Crawler Checks (20 bots)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        {demo.aiBots.map(c => (
          <div class={`flex items-center gap-2 p-2 rounded-lg text-sm ${c.allowed ? 'bg-geo-500/5' : 'bg-danger-500/5'}`}>
            <span class={`w-2 h-2 rounded-full ${c.allowed ? 'bg-geo-500' : 'bg-danger-500'}`}></span>
            <span class="font-mono text-gray-300">{c.bot}</span>
            <span class="text-gray-400 text-xs ml-auto">{c.tier}</span>
            <span class={`text-xs font-semibold ${c.allowed ? 'text-geo-400' : 'text-danger-400'}`}>{c.allowed ? 'Allowed' : 'Blocked'}</span>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-500 mt-3">
        {botsAllowed} of {demo.aiBots.length} AI crawlers allowed.{botsNote}
      </p>
    </div>

    <!-- Recommendations -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Priority Recommendations</h2>
      <div class="space-y-3">
        {demo.recommendations.map(r => (
          <div class="flex items-start gap-3 p-3 rounded-lg bg-white/5">
            <span class={`px-2 py-0.5 rounded text-xs font-bold ${r.priority === 'P0' ? 'bg-danger-500/20 text-danger-400' : r.priority === 'P1' ? 'bg-warn-500/20 text-warn-400' : 'bg-gray-500/20 text-gray-400'}`}>{r.priority}</span>
            <span class="text-sm text-gray-300 flex-1">{r.text}</span>
            <span class="text-xs text-geo-400 font-mono whitespace-nowrap">{r.impact}</span>
          </div>
        ))}
        <p class="text-xs text-gray-500 mt-3">Showing the top {demo.recommendations.length} of {demo.recommendationCount} highest-priority fixes from the full audit. The dimension that raised each one is shown on the right.</p>
      </div>
    </div>

    <!-- Generated Fix Files -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Auto-Generated Fix Files</h2>
      <p class="text-gray-400 text-sm mb-4">GeoScore generates three ready-to-deploy files based on your audit results:</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">📄</div>
          <h3 class="text-sm font-semibold text-white">llms.txt</h3>
          <p class="text-xs text-gray-500 mt-1">AI guidance file with site summary and key links</p>
        </div>
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">🤖</div>
          <h3 class="text-sm font-semibold text-white">robots.txt</h3>
          <p class="text-xs text-gray-500 mt-1">AI-crawler-friendly robots.txt with 20 bots allowed</p>
        </div>
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">🔧</div>
          <h3 class="text-sm font-semibold text-white">JSON-LD</h3>
          <p class="text-xs text-gray-500 mt-1">Structured data snippet for your &lt;head&gt; section</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center py-8">
      <h2 class="text-2xl font-bold mb-3">Run Your Own Audit</h2>
      <p class="text-gray-400 mb-6">See how your site scores across 11 dimensions and 20 AI crawlers. Free browser audit; sign-in is optional.</p>
      <a href="/" class="inline-block px-8 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 transition shadow-lg shadow-brand-500/20">Start Free Audit</a>
    </div>
  </section>
</Layout>
