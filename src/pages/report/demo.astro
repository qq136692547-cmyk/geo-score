---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Demo Report â€?GeoScore Sample Audit | GeoScore"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'GeoScore Demo Audit Report â€?Sample Website Analysis',
    description: 'See how GeoScore audits a real website. This demo report shows all 12 dimensions, 20 AI crawler checks, 75+ individual checks, and fix recommendations.',
    url: 'https://geoscore.help/report/demo/',
    author: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    datePublished: '2026-08-11',
    dateModified: '2026-08-11'
  }}
>
  <section class="max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-geo-500/10 text-geo-400 border border-geo-500/20 mb-4">
        Demo Report
      </div>
      <h1 class="text-4xl font-extrabold mb-3">Sample Audit Report</h1>
      <p class="text-gray-400 max-w-2xl mx-auto">See what a full GeoScore audit looks like â€?12 dimensions, 20 AI crawler checks, 75+ individual checks, fix files, and recommendations.</p>
    </div>

    <!-- Report Header -->
    <div class="card p-6 mb-6">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <p class="text-sm text-gray-500">Audited URL</p>
          <p class="text-lg font-mono text-white">example.com</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-extrabold text-geo-500">72</div>
          <div class="text-xs font-semibold text-geo-400 mt-1">Good</div>
        </div>
        <div class="text-right">
          <p class="text-sm text-gray-500">Audit Date</p>
          <p class="text-sm text-gray-300">2026-08-11</p>
        </div>
      </div>
      <div class="mt-4 p-3 rounded-lg bg-white/5 text-sm text-gray-400">
        Score 72/100 (Good). 8/11 dimensions above 60%. 2 negative signal(s) detected.
      </div>
    </div>

    <!-- Dimension Breakdown -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Dimension Breakdown</h2>
      <div class="space-y-3">
        {[
          { name: 'AI Crawlability (Robots.txt)', score: 92, weight: '12%', color: 'bg-geo-500' },
          { name: 'AI Guidance (llms.txt)', score: 75, weight: '12%', color: 'bg-geo-500' },
          { name: 'Structured Data (Schema)', score: 43, weight: '14%', color: 'bg-danger-500' },
          { name: 'Meta & Social Tags', score: 80, weight: '10%', color: 'bg-geo-500' },
          { name: 'Content Quality', score: 67, weight: '12%', color: 'bg-warn-500' },
          { name: 'E-E-A-T Signals', score: 50, weight: '8%', color: 'bg-warn-500' },
          { name: 'Brand & Entity', score: 75, weight: '8%', color: 'bg-geo-500' },
          { name: 'Citation Readiness', score: 63, weight: '8%', color: 'bg-warn-500' },
          { name: 'Discovery Endpoints', score: 100, weight: '6%', color: 'bg-geo-500' },
          { name: 'Agent-Friendliness', score: 50, weight: '4%', color: 'bg-warn-500' },
          { name: 'Freshness & Maintenance', score: 67, weight: '4%', color: 'bg-warn-500' },
        ].map(d => (
          <div>
            <div class="flex items-center justify-between text-sm mb-1">
              <span class="text-gray-300">{d.name}</span>
              <span class="text-gray-500 font-mono">{d.score}% <span class="text-gray-600">({d.weight})</span></span>
            </div>
            <div class="w-full h-2 rounded-full bg-gray-700/50 overflow-hidden">
              <div class={`h-full rounded-full ${d.color}`} style={`width:${d.score}%`}></div>
            </div>
          </div>
        ))}
        <div class="pt-2 border-t border-gray-700/50">
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-300">Negative Signals</span>
            <span class="text-danger-400 font-mono">-8 pts</span>
          </div>
          <p class="text-xs text-gray-500 mt-1">Detected: intrusive interstitials, missing alt text on 3 images</p>
        </div>
      </div>
    </div>

    <!-- AI Crawler Details -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">AI Crawler Checks (20 bots)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        {[
          { bot: 'GPTBot', status: true, tier: 'T1' },
          { bot: 'OAI-SearchBot', status: true, tier: 'T1' },
          { bot: 'ClaudeBot', status: true, tier: 'T1' },
          { bot: 'anthropic-ai', status: true, tier: 'T1' },
          { bot: 'PerplexityBot', status: true, tier: 'T1' },
          { bot: 'Google-Extended', status: true, tier: 'T1' },
          { bot: 'CCBot', status: true, tier: 'T2' },
          { bot: 'Bytespider', status: false, tier: 'T2' },
          { bot: 'meta-externalagent', status: true, tier: 'T2' },
          { bot: 'Amazonbot', status: false, tier: 'T2' },
          { bot: 'Applebot-Extended', status: false, tier: 'T2' },
          { bot: 'ChatGPT-User', status: true, tier: 'T2' },
          { bot: 'Claude-SearchBot', status: false, tier: 'T2' },
          { bot: 'cohere-ai', status: false, tier: 'T3' },
          { bot: 'DuckAssistBot', status: false, tier: 'T3' },
          { bot: 'AI2Bot', status: false, tier: 'T3' },
          { bot: 'xAI-Bot', status: false, tier: 'T3' },
          { bot: 'Perplexity-User', status: true, tier: 'T3' },
          { bot: 'YouBot', status: false, tier: 'T3' },
          { bot: 'PetalBot', status: true, tier: 'T3' },
        ].map(c => (
          <div class={`flex items-center gap-2 p-2 rounded-lg text-sm ${c.status ? 'bg-geo-500/5' : 'bg-danger-500/5'}`}>
            <span class={`w-2 h-2 rounded-full ${c.status ? 'bg-geo-500' : 'bg-danger-500'}`}></span>
            <span class="font-mono text-gray-300">{c.bot}</span>
            <span class="text-gray-600 text-xs ml-auto">{c.tier}</span>
            <span class={`text-xs font-semibold ${c.status ? 'text-geo-400' : 'text-danger-400'}`}>{c.status ? 'Allowed' : 'Blocked'}</span>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-500 mt-3">12 of 20 AI crawlers allowed. Missing: Bytespider, Amazonbot, Applebot-Extended, Claude-SearchBot, cohere-ai, DuckAssistBot, AI2Bot, xAI-Bot, YouBot.</p>
    </div>

    <!-- Recommendations -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Priority Recommendations</h2>
      <div class="space-y-3">
        {[
          { priority: 'P0', text: 'Add Applebot-Extended, Amazonbot, and Claude-SearchBot to robots.txt Allow list', impact: '+6 points' },
          { priority: 'P0', text: 'Add JSON-LD Article schema with author, datePublished, and dateModified', impact: '+8 points' },
          { priority: 'P1', text: 'Add llms.txt file with site summary and key page links', impact: '+5 points' },
          { priority: 'P1', text: 'Fix missing alt text on 3 images (accessibility + AI context)', impact: '+3 points' },
          { priority: 'P1', text: 'Add author bio page with credentials for E-E-A-T', impact: '+4 points' },
          { priority: 'P2', text: 'Add FAQPage schema for Q&A content', impact: '+2 points' },
          { priority: 'P2', text: 'Update content: last blog post was 45 days ago', impact: '+2 points' },
        ].map(r => (
          <div class="flex items-start gap-3 p-3 rounded-lg bg-white/5">
            <span class={`px-2 py-0.5 rounded text-xs font-bold ${r.priority === 'P0' ? 'bg-danger-500/20 text-danger-400' : r.priority === 'P1' ? 'bg-warn-500/20 text-warn-400' : 'bg-gray-500/20 text-gray-400'}`}>{r.priority}</span>
            <span class="text-sm text-gray-300 flex-1">{r.text}</span>
            <span class="text-xs text-geo-400 font-mono whitespace-nowrap">{r.impact}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Generated Fix Files -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Auto-Generated Fix Files</h2>
      <p class="text-gray-400 text-sm mb-4">GeoScore generates three ready-to-deploy files based on your audit results:</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">ðŸ“„</div>
          <h3 class="text-sm font-semibold text-white">llms.txt</h3>
          <p class="text-xs text-gray-500 mt-1">AI guidance file with site summary and key links</p>
        </div>
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">ðŸ¤–</div>
          <h3 class="text-sm font-semibold text-white">robots.txt</h3>
          <p class="text-xs text-gray-500 mt-1">AI-crawler-friendly robots.txt with 20 bots allowed</p>
        </div>
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">ðŸ”§</div>
          <h3 class="text-sm font-semibold text-white">JSON-LD</h3>
          <p class="text-xs text-gray-500 mt-1">Structured data snippet for your &lt;head&gt; section</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center py-8">
      <h2 class="text-2xl font-bold mb-3">Run Your Own Audit</h2>
      <p class="text-gray-400 mb-6">See how your site scores across 12 dimensions and 20 AI crawlers. Free, no signup.</p>
      <a href="/" class="inline-block px-8 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 transition shadow-lg shadow-brand-500/20">Start Free Audit</a>
    </div>
  </section>
</Layout>
