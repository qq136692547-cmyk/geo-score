---
import LayoutZh from '../../layouts/LayoutZh.astro';
---
<LayoutZh title="GeoScore 定价 - 免费与专业版" schema={{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'GeoScore 真的免费吗？',
      acceptedAnswer: { '@type': 'Answer', text: '单次浏览器审计、CLI 和 MCP Server 免费。登录可选；Pro 监控和历史记录为付费功能。源代码以 MIT 协议开源在 GitHub。' }
    },
    {
      '@type': 'Question',
      name: '需要信用卡吗？',
      acceptedAnswer: { '@type': 'Answer', text: 'Free 计划无需信用卡。Pro、Studio 和 Agency 计划均包含 7 天免费试用，试用期结束后才会扣费；Pro 年付按年一次性支付 $79，不提供试用。' }
    },
    {
      '@type': 'Question',
      name: '可以随时取消吗？',
      acceptedAnswer: { '@type': 'Answer', text: '可以。在客户门户随时取消，当前计费周期结束前保持访问权限。' }
    },
    {
      '@type': 'Question',
      name: 'GeoScore 和闭源的 GEO 监测工具有什么不同？',
      acceptedAnswer: { '@type': 'Answer', text: 'GeoScore 是开源的（MIT）：提供 CLI 和 MCP Server，可指向任意 LLM 端点；免费浏览器审计还包含提示词注入检测。闭源监测套件按域名收月费，评分逻辑不公开。它们报告 AI 引擎如何提及你；GeoScore 审计的是你的站点为这些引擎提供了哪些可用素材——11 个维度，并附可直接应用的修复文件。' }
    },
    {
      '@type': 'Question',
      name: '你们处理 VAT 和税务吗？',
      acceptedAnswer: { '@type': 'Answer', text: '是的。我们的支付合作伙伴 Creem 作为记录商户（MoR），自动处理 190+ 个国家的 VAT、GST 和销售税合规。您无需操心税务表格。' }
    },
    {
      '@type': 'Question',
      name: '可以帮我直接把修复做完吗？',
      acceptedAnswer: { '@type': 'Answer', text: '可以。AI 可见度 Fix Pack 是一次性 $49 的代做服务：按你的目录定制 llms.txt、为 robots.txt 写显式 AI 爬虫放行规则、补全一款畅销商品的 Product schema、一页纸审计，部署后复检。直接通过邮件（hello@geoscore.help）沟通，先免费诊断，48 小时交付。' }
    },
    {
      '@type': 'Question',
      name: 'Studio 和 Agency 计划可用吗？',
      acceptedAnswer: { '@type': 'Answer', text: '是的。Studio（$29/月）和 Agency（$59/月）现已正式开放并包含 7 天免费试用。你可以直接订阅以获得更多监控域名、更高审计频率及团队工作区功能。' }
    }
  ]
}}>
  <section class="max-w-5xl mx-auto py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
        简单<span class="gradient-text">透明</span>的定价
      </h1>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        单次审计永久免费。需要监控、历史记录或团队功能时再升级。
      </p>
    </div>

    <!-- 计费周期全局切换 -->
    <div class="flex justify-center mb-10">
      <div class="inline-flex items-center p-1 rounded-xl bg-gray-800/90 border border-gray-700/80 text-sm shadow-inner" role="group" aria-label="计费周期">
        <button type="button" id="billing-cycle-monthly" class="py-1.5 px-5 rounded-lg font-medium transition cursor-pointer bg-brand-500 text-white shadow-sm flex items-center gap-1.5">
          按月付费
        </button>
        <button type="button" id="billing-cycle-annual" class="py-1.5 px-5 rounded-lg font-medium transition cursor-pointer text-gray-400 hover:text-white flex items-center gap-2">
          按年付费
          <span class="px-2 py-0.5 text-xs font-semibold bg-brand-500/20 text-brand-300 border border-brand-500/30 rounded-full">Pro 立省 25%</span>
        </button>
      </div>
    </div>

    <!-- 3 列核心定价网格 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch mb-10">
      <!-- Card 1: Free -->
      <div class="card p-5 lg:p-6 flex flex-col justify-between h-full relative">
        <!-- Area 1: 标题与标签 -->
        <div class="flex items-center justify-between mb-3 h-[28px]">
          <div class="text-base font-bold text-gray-200">Free</div>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-gray-800 text-gray-400 border border-gray-700">基础版</span>
        </div>
        <!-- Area 2: 主价格 -->
        <div class="h-[44px] flex items-baseline mb-1">
          <span class="text-3xl font-extrabold text-white tracking-tight">$0</span>
          <span class="text-sm font-normal text-gray-400 ml-1.5">/ 永久</span>
        </div>
        <!-- Area 3: 计费说明 -->
        <div class="h-[20px] mb-5 flex items-center text-xs text-gray-500 whitespace-nowrap">永久免费 · 快速上手</div>
        <!-- Area 4: 功能列表 (精准 6 项，单行对齐) -->
        <ul class="border-t border-gray-700/50 pt-5 mb-6 space-y-3 flex-1 text-xs md:text-[13px] text-gray-300">
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>单 URL 深度审计</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>11 维度 85 项全检</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>修复文件生成器</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>CLI & MCP 本地工具</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>完整开源 (MIT 协议)</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>永久免费，无需绑卡</span></li>
        </ul>
        <!-- Area 5: 底部操作按钮 -->
        <div class="mt-auto">
          <a href="/zh/#url-input" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 bg-gray-800/40 text-gray-300 hover:border-gray-500 hover:text-white transition">开始使用</a>
        </div>
      </div>

      <!-- Card 2: Pro (热门推荐) -->
      <div class="card p-5 lg:p-6 flex flex-col justify-between h-full relative ring-2 ring-brand-500 bg-gradient-to-b from-brand-950/20 to-transparent shadow-lg shadow-brand-500/10">
        <!-- Area 1: 标题与标签 -->
        <div class="flex items-center justify-between mb-3 h-[28px]">
          <div class="text-base font-bold text-brand-400">Pro</div>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-brand-500/20 text-brand-400 border border-brand-500/40">热门推荐</span>
        </div>
        <!-- Area 2: 主价格 -->
        <div class="h-[44px] flex items-baseline mb-1">
          <span class="text-3xl font-extrabold text-white tracking-tight" id="pro-price-val">$9</span>
          <span class="text-sm font-normal text-gray-400 ml-1.5" id="pro-period-unit">/ 月</span>
        </div>
        <!-- Area 3: 计费说明 -->
        <div class="h-[20px] mb-5 flex items-center text-xs text-brand-400/90 font-medium whitespace-nowrap" id="pro-billing-note">7 天免费试用 · 随时取消</div>
        <!-- Area 4: 功能列表 (精准 6 项，单行对齐) -->
        <ul class="border-t border-brand-500/30 pt-5 mb-6 space-y-3 flex-1 text-xs md:text-[13px] text-gray-300">
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>包含 Free 全部功能</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>5 个域名自动监控</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>30 天历史与回归告警</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>专业 PDF 报告导出</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>AI 引用模拟分析 (30 次/月)</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>优先邮件技术支持</span></li>
        </ul>
        <!-- Area 5: 底部操作按钮 -->
        <div class="mt-auto">
          <button id="upgrade-pro" type="button" data-plan="pro" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 shadow-md shadow-brand-500/25 hover:shadow-brand-500/40 transition cursor-pointer">开始 7 天试用</button>
        </div>
      </div>

      <!-- Card 3: AI 可见度 Fix Pack (人工代做) -->
      <div class="card p-5 lg:p-6 flex flex-col justify-between h-full relative border-geo-500/30 bg-gradient-to-b from-geo-950/20 to-transparent shadow-lg shadow-geo-500/10">
        <!-- Area 1: 标题与标签 -->
        <div class="flex items-center justify-between mb-3 h-[28px]">
          <div class="text-base font-bold text-geo-400">Fix Pack</div>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-geo-500/20 text-geo-400 border border-geo-500/40">人工代做</span>
        </div>
        <!-- Area 2: 主价格 -->
        <div class="h-[44px] flex items-baseline mb-1">
          <span class="text-3xl font-extrabold text-white tracking-tight">$49</span>
          <span class="text-sm font-normal text-gray-400 ml-1.5">/ 单次</span>
        </div>
        <!-- Area 3: 计费说明 -->
        <div class="h-[20px] mb-5 flex items-center text-xs text-gray-400 whitespace-nowrap">一次性支付 · 无需订阅</div>
        <!-- Area 4: 功能列表 (精准 6 项，单行对齐) -->
        <ul class="border-t border-geo-500/30 pt-5 mb-6 space-y-3 flex-1 text-xs md:text-[13px] text-gray-300">
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>定制目录级 llms.txt 文件</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>AI 爬虫显式 robots.txt 规则</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>畅销商品 Product schema 补全</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>1 页纸人工深度诊断报告</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>上线部署后二次复检</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>人工交付 · 48 小时保质交付</span></li>
        </ul>
        <!-- Area 5: 底部操作按钮 -->
        <div class="mt-auto">
          <a id="fixpack-cta" href="/zh/fixpack/" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-geo-500/50 bg-geo-500/10 text-geo-300 hover:bg-geo-500 hover:text-white transition">获取 Fix Pack ($49) →</a>
        </div>
      </div>
    </div>

    <!-- Studio & Agency 提示条 -->
    <div class="card p-5 md:p-6 mb-12 border-gray-700/60 bg-gradient-to-r from-gray-900/90 via-gray-800/50 to-gray-900/90 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">团队与企业方案</span>
          <h3 class="text-base font-semibold text-white">Studio 与 Agency 计划</h3>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed">
          需要更高频监控、15+ 域名管理或白标 PDF 报告？Studio（$29/月）与 Agency（$59/月）包含每日/每小时监控、团队工作区与独立 API 访问权限，均享 7 天免费试用。
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a href="#feature-comparison" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-300 bg-gray-800 border border-gray-700 hover:border-gray-500 hover:text-white transition text-center">对比所有方案</a>
        <button id="upgrade-studio" type="button" data-plan="studio" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_yvmQsDZnoKHNXtDpJt51x" class="px-4 py-2 rounded-lg text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm transition cursor-pointer text-center whitespace-nowrap">开启 Studio 试用</button>
      </div>
    </div>

    <!-- WorkBuddy 国内企业专享提示条 -->
    <div id="workbuddy-expert-plan" class="card p-5 md:p-6 mb-12 border-emerald-500/30 bg-gradient-to-r from-emerald-950/30 via-gray-900/70 to-geo-950/30 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex-1">
        <div class="flex flex-wrap items-center gap-2 mb-1.5">
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">国内用户专享 · 人民币一次性买断</span>
          <h3 class="text-base font-semibold text-white">WorkBuddy 国内企业官网 GEO 专家团（¥29）</h3>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed">
          无需外币信用卡或按月订阅。适合面向 Kimi、豆包、DeepSeek、秘塔、元宝等国产大模型的企业官网团队：本地完成 11 维 85 项审计、9 大国产爬虫与 ICP/公安备案核验，一键产出中文修复包与离线 SVG+HTML 战报。
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a href="https://www.workbuddy.cn/share/asset?shareCode=uAZqr7A5thAbrsgBgOfP4Q&sig=hq2cpnWtrzyM5upa" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg text-sm font-semibold text-white bg-gradient-to-r from-emerald-600 to-geo-600 hover:from-emerald-500 hover:to-geo-500 shadow-sm transition text-center whitespace-nowrap">
          前往 WorkBuddy 获取 (¥29) →
        </a>
      </div>
    </div>

    <!-- 对比表 -->
    <div id="feature-comparison" class="card p-6 md:p-8 mb-12 scroll-mt-6">
      <h2 class="text-xl font-bold mb-6 text-center">功能对比</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-700">
              <th scope="col" class="text-left py-3 text-gray-400 font-medium">功能</th>
              <th scope="col" class="text-center py-3 text-gray-400 font-medium">Free</th>
              <th scope="col" class="text-center py-3 text-brand-400 font-medium">Pro</th>
              <th scope="col" class="text-center py-3 text-geo-400 font-medium">Studio</th>
              <th scope="col" class="text-center py-3 text-gray-300 font-medium">Agency</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700/50">
            <tr><td class="py-2.5 text-gray-300">单 URL 审计</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">11 维度 85 检查项</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">修复文件生成器</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">CLI & MCP Server</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">自动审计</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">每周</td><td class="text-center text-gray-300">每日</td><td class="text-center text-gray-300">每小时</td></tr>
            <tr><td class="py-2.5 text-gray-300">审计历史</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">30 天</td><td class="text-center text-gray-300">12 个月</td><td class="text-center text-gray-300">无限</td></tr>
            <tr><td class="py-2.5 text-gray-300">回归告警</td><td class="text-center text-gray-400">—</td><td class="text-center">✓</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">PDF 导出</td><td class="text-center text-gray-400">—</td><td class="text-center">✓</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">竞品对比</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">API 访问</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">团队工作区</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">白标报告</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">域名数</td><td class="text-center text-gray-300">1</td><td class="text-center text-brand-400">5</td><td class="text-center text-geo-400">15</td><td class="text-center text-gray-300">50</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">价格</td><td class="text-center text-gray-300">$0</td><td class="text-center text-brand-400">$9/月</td><td class="text-center text-geo-400">$29/月</td><td class="text-center text-gray-300">$59/月</td></tr>
          </tbody>
        </table>
      </div>
      <div class="mt-6 pt-4 border-t border-gray-700/50 flex flex-wrap justify-between items-center gap-3 text-xs text-gray-400">
        <div>所有付费方案均包含 7 天免费试用 · 随时取消</div>
        <button id="upgrade-agency" type="button" data-plan="agency" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_7Itt3xoxDKLaItFqjfhv7x" class="px-4 py-2 rounded-lg border border-gray-700 bg-gray-800/80 hover:border-indigo-500 hover:text-white text-gray-300 transition cursor-pointer font-medium">开启 Agency 试用（$59/月）→</button>
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-6">定价常见问题</h2>
      <div class="space-y-4">
        <div class="card p-5">
          <h3 class="font-semibold mb-2">GeoScore 真的免费吗？</h3>
          <p class="text-sm text-gray-400">单次浏览器审计、CLI 和 MCP Server 免费。登录可选；Pro 监控和历史记录为付费功能。源代码以 MIT 协议开源在 GitHub。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">需要信用卡吗？</h3>
          <p class="text-sm text-gray-400">Free 计划无需信用卡。Pro、Studio 和 Agency 计划均包含 7 天免费试用，试用期结束后才会扣费；Pro 年付按年一次性支付 $79，不提供试用。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">可以随时取消吗？</h3>
          <p class="text-sm text-gray-400">可以。在客户门户随时取消，当前计费周期结束前保持访问权限。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">GeoScore 和闭源的 GEO 监测工具有什么不同？</h3>
          <p class="text-sm text-gray-400">GeoScore 是开源的（MIT）：提供 CLI 和 MCP Server，可指向任意 LLM 端点；免费浏览器审计还包含提示词注入检测。闭源监测套件按域名收月费，评分逻辑不公开。它们报告 AI 引擎如何提及你；GeoScore 审计的是你的站点为这些引擎提供了哪些可用素材——11 个维度，并附可直接应用的修复文件。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">你们处理 VAT 和税务吗？</h3>
          <p class="text-sm text-gray-400">是的。我们的支付合作伙伴 Creem 作为记录商户（MoR），自动处理 190+ 个国家的 VAT、GST 和销售税合规。您无需操心税务表格。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">可以帮我直接把修复做完吗？</h3>
          <p class="text-sm text-gray-400">可以。<a href="/zh/fixpack/" class="text-brand-400 hover:underline">AI 可见度 Fix Pack</a> 是一次性 $49 的代做服务：按你的目录定制 llms.txt、为 robots.txt 写显式 AI 爬虫放行规则、补全一款畅销商品的 Product schema、一页纸审计，部署后复检。直接通过邮件（hello@geoscore.help）沟通，先免费诊断，48 小时交付。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Studio 和 Agency 计划可用吗？</h3>
          <p class="text-sm text-gray-400">是的。Studio（$29/月）和 Agency（$59/月）现已正式开放并包含 7 天免费试用。你可以直接订阅以获得更多监控域名、更高审计频率及团队工作区功能。</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'GeoScore 定价',
    description: 'GEO 审计工具，提供自动化监控、回归告警及 PDF 报告导出',
    brand: { '@type': 'Brand', name: 'GeoScore' },
    offers: [
      { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: '免费版', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', price: '9', priceCurrency: 'USD', name: 'Pro 月付', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5' },
      { '@type': 'Offer', price: '79', priceCurrency: 'USD', name: 'Pro 年付', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_2OZLydXjeAKD3HyVY20eEN' },
      { '@type': 'Offer', price: '29', priceCurrency: 'USD', name: 'Studio 月付', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_yvmQsDZnoKHNXtDpJt51x' },
      { '@type': 'Offer', price: '59', priceCurrency: 'USD', name: 'Agency 月付', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_7Itt3xoxDKLaItFqjfhv7x' },
      { '@type': 'Offer', price: '49', priceCurrency: 'USD', name: 'AI 可见度 Fix Pack（一次性代做）', availability: 'https://schema.org/InStock', url: 'https://geoscore.help/zh/fixpack/' }
    ]
  })} />

  <script>
    import { showToast } from '../../scripts/toast.js';
    // Pro / Studio / Agency 结账：每个计划/周期发起对应的 Creem 结账。
    // trial_started beacon 在跳转前触发（API 与静态链接两条路径都覆盖），
    // 避免页面卸载丢掉「点击→结账」这一步。
    async function startCheckout(btn) {
      const period = btn.getAttribute('data-billing') || 'monthly';
      const plan = btn.getAttribute('data-plan') || 'pro';
      const ctaId = btn.getAttribute('data-cta') || ('pricing_' + plan);
      const sourceType = window.geoSource ? window.geoSource() : 'other';
      if (window.geoTrack) {
        window.geoTrack('upgrade_cta_clicked', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType });
      }
      const token = localStorage.getItem('geoscore_token');
      if (!token) {
        try {
          localStorage.setItem('geoscore_pending_checkout', JSON.stringify({ plan: plan, period: period, ts: Date.now() }));
        } catch (e) { }
        if (window.geoscoreAuth) {
          window.geoscoreAuth.openAuthModal();
        } else {
          showToast('请先登录后再开始试用', 'info');
        }
        return;
      }
      const successUrl = location.origin + '/zh/pricing/?checkout=success';
      const leave = function (url) {
        if (window.geoTrack) {
          // transport_type beacon：紧接着页面就卸载了，必须用 sendBeacon 送出去。
          // checkout_started 标记「点击 → 进入 Creem」之间的一步，缺了它就看不到在哪流失。
          window.geoTrack('checkout_started', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType, transport_type: 'beacon' });
          window.geoTrack('trial_started', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType, transport_type: 'beacon' });
        }
        window.location.href = url;
      };
      const fallbackUrl = btn.getAttribute('data-checkout');
      // 为已登录用户创建绑定邮箱的 Creem 结账会话；
      // Worker API 不可用时回退到静态结账链接。
      if (window.geoscoreAuth && window.geoscoreAuth.api) {
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.textContent = '正在创建结账...';
        try {
          const res = await window.geoscoreAuth.api('/api/checkout', { method: 'POST', body: { plan: plan, billing_period: period, success_url: successUrl } });
          if (res.ok && res.data && res.data.checkout_url) {
            leave(res.data.checkout_url);
            return;
          }
        } catch (e) {
          // Worker 不可达或超时；回退到静态链接
        }
        btn.disabled = false;
        btn.innerHTML = original;
      }
      if (fallbackUrl) leave(fallbackUrl);
    }
    const planButtons = document.querySelectorAll('[data-billing]');
    for (let i = 0; i < planButtons.length; i++) {
      planButtons[i].addEventListener('click', function () { startCheckout(this); });
    }

    // 全局计费周期切换 (月付 / 年付)
    const btnMonthly = document.getElementById('billing-cycle-monthly');
    const btnAnnual = document.getElementById('billing-cycle-annual');
    const proPriceVal = document.getElementById('pro-price-val');
    const proPeriodUnit = document.getElementById('pro-period-unit');
    const proBillingNote = document.getElementById('pro-billing-note');
    const proBtn = document.getElementById('upgrade-pro');

    function setBillingCycle(cycle) {
      if (!proPriceVal || !proBtn) return;
      if (cycle === 'annual') {
        proPriceVal.textContent = '$79';
        if (proPeriodUnit) proPeriodUnit.textContent = '/ 年';
        if (proBillingNote) proBillingNote.textContent = '年付 $79 · 立省 $29';
        proBtn.setAttribute('data-billing', 'annual');
        proBtn.setAttribute('data-checkout', 'https://www.creem.io/payment/prod_2OZLydXjeAKD3HyVY20eEN');
        proBtn.textContent = '立即订阅';
        if (btnMonthly && btnAnnual) {
          btnAnnual.className = 'py-1.5 px-5 rounded-lg font-medium transition cursor-pointer bg-brand-500 text-white shadow-sm flex items-center gap-2';
          btnMonthly.className = 'py-1.5 px-5 rounded-lg font-medium transition cursor-pointer text-gray-400 hover:text-white flex items-center gap-1.5';
        }
      } else {
        proPriceVal.textContent = '$9';
        if (proPeriodUnit) proPeriodUnit.textContent = '/ 月';
        if (proBillingNote) proBillingNote.textContent = '7 天免费试用 · 随时取消';
        proBtn.setAttribute('data-billing', 'monthly');
        proBtn.setAttribute('data-checkout', 'https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5');
        proBtn.textContent = '开始 7 天试用';
        if (btnMonthly && btnAnnual) {
          btnMonthly.className = 'py-1.5 px-5 rounded-lg font-medium transition cursor-pointer bg-brand-500 text-white shadow-sm flex items-center gap-1.5';
          btnAnnual.className = 'py-1.5 px-5 rounded-lg font-medium transition cursor-pointer text-gray-400 hover:text-white flex items-center gap-2';
        }
      }
    }

    if (btnMonthly) {
      btnMonthly.addEventListener('click', function () { setBillingCycle('monthly'); });
    }
    if (btnAnnual) {
      btnAnnual.addEventListener('click', function () { setBillingCycle('annual'); });
    }

    // Creem 付款后带 ?checkout=success 回到本页。每个会话只上报一次，
    // 刷新不得重复计入转化。
    if (new URLSearchParams(location.search).get('checkout') === 'success') {
      let alreadyReported = false;
      try {
        alreadyReported = sessionStorage.getItem('geoscore_checkout_returned') === '1';
        if (!alreadyReported) sessionStorage.setItem('geoscore_checkout_returned', '1');
      } catch (e) { /* storage 不可用：宁可上报也不要丢事件 */ }
      if (!alreadyReported && window.geoTrack) {
        window.geoTrack('checkout_returned', {
          source_type: window.geoSource ? window.geoSource() : 'other',
          transport_type: 'beacon',
        });
      }
      renderCheckoutSuccess();
    }

    function renderCheckoutSuccess() {
      const host = document.querySelector('section');
      if (!host || document.getElementById('checkout-success')) return;
      const box = document.createElement('div');
      box.id = 'checkout-success';
      box.setAttribute('role', 'status');
      box.className = 'card p-6 mb-8 border-geo-500/40 bg-geo-500/10';
      box.innerHTML =
        '<h2 class="text-lg font-bold text-white mb-2">付款成功，订阅已生效</h2>' +
        '<p class="text-sm text-gray-300 mb-4">' +
          '你的账号已升级。监控面板在首页，跑一次审计后即可看到监控、历史与 AI 可见度。' +
        '</p>' +
        '<a href="/zh/#pro-monitor-root" class="inline-block px-4 py-2 rounded-lg bg-geo-500 hover:bg-geo-600 text-white text-sm font-semibold transition">' +
          '打开监控面板 →' +
        '</a>';
      host.insertBefore(box, host.firstChild);
    }

    // 恢复因登录流程中断的结账
    (function resumePendingCheckout() {
      let pending = null;
      try {
        pending = JSON.parse(localStorage.getItem('geoscore_pending_checkout') || 'null');
        localStorage.removeItem('geoscore_pending_checkout');
      } catch (e) { return; }
      if (!pending || !pending.period) return;
      if (!localStorage.getItem('geoscore_token')) return;
      if (Date.now() - pending.ts > 10 * 60 * 1000) return;
      if (pending.plan === 'pro' && pending.period === 'annual') {
        setBillingCycle('annual');
      }
      const selector = pending.plan
        ? '[data-plan="' + pending.plan + '"][data-billing="' + pending.period + '"]'
        : '[data-billing="' + pending.period + '"]';
      const btn = document.querySelector(selector) || document.querySelector('[data-billing="' + pending.period + '"]');
      if (btn) startCheckout(btn);
    })();

    // 漏斗埋点（2026-10-23 重造补齐）：定价页此前没有浏览事件，付费漏斗顶部不可测。
    if (window.geoTrack) {
      window.geoTrack('pricing_viewed', { source_type: window.geoSource ? window.geoSource() : 'other' });
    }
    const fixpackCta = document.getElementById('fixpack-cta');
    if (fixpackCta) {
      fixpackCta.addEventListener('click', function () {
        if (window.geoTrack) window.geoTrack('fixpack_cta_clicked', { placement: 'pricing_card', transport_type: 'beacon' });
      });
    }
  </script>
</LayoutZh>
