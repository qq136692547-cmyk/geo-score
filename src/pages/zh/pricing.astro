---
import LayoutZh from '../../layouts/LayoutZh.astro';
---
<LayoutZh title="GeoScore 定价 - 免费与专业版">
  <section class="max-w-5xl mx-auto py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
        简单<span class="gradient-text">透明</span>的定价
      </h1>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        单次审计永久免费。需要监控、历史记录或团队功能时再升级。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
      <!-- Free -->
      <div class="card p-6 flex flex-col">
        <div class="text-sm font-semibold text-gray-400 mb-2">Free</div>
        <div class="text-3xl font-extrabold mb-1">¥0</div>
        <div class="text-xs text-gray-500 mb-6">永久免费</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 单 URL 审计</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 12 维度，85+ 检查项</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 修复文件生成器</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> CLI & MCP Server</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 无需注册</li>
        </ul>
        <a href="/zh/" class="block text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-600 text-gray-300 hover:border-brand-500 hover:text-white transition">开始使用</a>
      </div>

      <!-- Pro -->
      <div class="card p-6 flex flex-col ring-2 ring-brand-500/50 relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full text-xs font-semibold bg-brand-500 text-white">热门</div>
        <div class="text-sm font-semibold text-brand-400 mb-2">Pro</div>
        <div class="text-3xl font-extrabold mb-1">$9<span class="text-base font-normal text-gray-500">/月</span></div>
        <div class="text-xs text-gray-500 mb-6">7 天免费试用</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-brand-500">✓</span> Free 全部功能</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 每周自动审计</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 30 天审计历史</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 回归告警</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> PDF 导出</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 5 个域名</li>
        </ul>
        <button id="upgrade-pro" data-checkout="https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 transition cursor-pointer">开始免费试用</button>
      </div>

      <!-- Studio (敬请期待) -->
      <div class="card p-6 flex flex-col opacity-50 cursor-not-allowed">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full text-xs font-semibold bg-gray-700 text-gray-300">敬请期待</div>
        <div class="text-sm font-semibold text-geo-400 mb-2">Studio</div>
        <div class="text-3xl font-extrabold mb-1">$29<span class="text-base font-normal text-gray-500">/月</span></div>
        <div class="text-xs text-gray-500 mb-6">7 天免费试用</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Pro 全部功能</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 每日自动审计</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 12 个月审计历史</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 竞品对比</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 15 个域名</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> API 访问</li>
        </ul>
        <button disabled class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 text-gray-500 cursor-not-allowed">敬请期待</button>
      </div>

      <!-- Agency (敬请期待) -->
      <div class="card p-6 flex flex-col opacity-50 cursor-not-allowed">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full text-xs font-semibold bg-gray-700 text-gray-300">敬请期待</div>
        <div class="text-sm font-semibold text-gray-400 mb-2">Agency</div>
        <div class="text-3xl font-extrabold mb-1">$59<span class="text-base font-normal text-gray-500">/月</span></div>
        <div class="text-xs text-gray-500 mb-6">7 天免费试用</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Studio 全部功能</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 每小时审计</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 无限审计历史</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 团队工作区</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 50 个域名</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 白标 PDF 报告</li>
        </ul>
        <button disabled class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 text-gray-500 cursor-not-allowed">敬请期待</button>
      </div>
    </div>

    <!-- 对比表 -->
    <div class="card p-6 md:p-8 mb-12">
      <h2 class="text-xl font-bold mb-6 text-center">功能对比</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-700">
              <th class="text-left py-3 text-gray-400 font-medium">功能</th>
              <th class="text-center py-3 text-gray-400 font-medium">Free</th>
              <th class="text-center py-3 text-brand-400 font-medium">Pro</th>
              <th class="text-center py-3 text-gray-500 font-medium">Studio <span class="text-xs">(即将)</span></th>
              <th class="text-center py-3 text-gray-500 font-medium">Agency <span class="text-xs">(即将)</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700/50">
            <tr><td class="py-2.5 text-gray-300">单 URL 审计</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">12 维度 85+ 检查项</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">修复文件生成器</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">CLI & MCP Server</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">自动审计</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-300">每周</td><td class="text-center text-gray-500">每日</td><td class="text-center text-gray-500">每小时</td></tr>
            <tr><td class="py-2.5 text-gray-300">审计历史</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-300">30 天</td><td class="text-center text-gray-500">12 个月</td><td class="text-center text-gray-500">无限</td></tr>
            <tr><td class="py-2.5 text-gray-300">回归告警</td><td class="text-center text-gray-600">—</td><td class="text-center">✓</td><td class="text-center text-gray-500">✓</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">PDF 导出</td><td class="text-center text-gray-600">—</td><td class="text-center">✓</td><td class="text-center text-gray-500">✓</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">竞品对比</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-500">✓</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">API 访问</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-500">✓</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">团队工作区</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">白标报告</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-600">—</td><td class="text-center text-gray-500">✓</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">域名数</td><td class="text-center text-gray-300">1</td><td class="text-center text-brand-400">5</td><td class="text-center text-gray-500">15</td><td class="text-center text-gray-500">50</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">价格</td><td class="text-center text-gray-300">¥0</td><td class="text-center text-brand-400">$9/月</td><td class="text-center text-gray-500">$29/月</td><td class="text-center text-gray-500">$59/月</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-6">定价常见问题</h2>
      <div class="space-y-4">
        <div class="card p-5">
          <h3 class="font-semibold mb-2">GeoScore 真的免费吗？</h3>
          <p class="text-sm text-gray-400">是的。单 URL 审计、CLI 和 MCP Server 永久免费，无需注册。源代码以 MIT 协议开源在 GitHub。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">需要信用卡吗？</h3>
          <p class="text-sm text-gray-400">Free 计划无需信用卡。Pro 计划包含 7 天免费试用，试用期结束后才会扣费。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">可以随时取消吗？</h3>
          <p class="text-sm text-gray-400">可以。在客户门户随时取消，当前计费周期结束前保持访问权限。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">GeoScore 和 GeoReady 有什么不同？</h3>
          <p class="text-sm text-gray-400">GeoScore 是开源的（MIT），支持中文，内置 CLI 和 MCP Server，包含提示注入检测——全部免费。GeoReady 对类似监控功能收费 $9-89/月。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">你们处理 VAT 和税务吗？</h3>
          <p class="text-sm text-gray-400">是的。我们的支付合作伙伴 Creem 作为记录商户（MoR），自动处理 190+ 个国家的 VAT、GST 和销售税合规。您无需操心税务表格。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Studio 和 Agency 什么时候推出？</h3>
          <p class="text-sm text-gray-400">Studio 和 Agency 即将推出。我们先以 Pro 启动，验证工作流程。请关注我们的 <a href="https://github.com/qq136692547-cmyk/geo-score" class="text-brand-400 hover:underline">GitHub 仓库</a> 获取更新。</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Pro 结账：已登录用户跳转 Creem，否则提示登录
    const proBtn = document.getElementById('upgrade-pro');
    if (proBtn) {
      proBtn.addEventListener('click', async function() {
        const token = localStorage.getItem('geoscore_token');
        if (!token) {
          if (window.geoscoreAuth) {
            window.geoscoreAuth.openAuthModal();
          } else {
            alert('请先登录后再开始试用');
          }
          return;
        }
        // 为已登录用户创建绑定邮箱的 Creem 结账会话；
        // Worker API 不可用时回退到静态结账链接。
        if (window.geoscoreAuth && window.geoscoreAuth.api) {
          const btn = this;
          const original = btn.textContent;
          btn.disabled = true;
          btn.textContent = '正在创建结账...';
          try {
            const res = await window.geoscoreAuth.api('/api/checkout', { method: 'POST', body: {} });
            if (res.ok && res.data && res.data.checkout_url) {
              window.location.href = res.data.checkout_url;
              return;
            }
          } catch (e) {
            // Worker 不可达或超时；回退到静态链接
          }
          btn.disabled = false;
          btn.textContent = original;
        }
        // 回退：跳转静态 Creem 结账链接
        const checkoutUrl = proBtn.getAttribute('data-checkout');
        if (checkoutUrl) {
          window.location.href = checkoutUrl;
        }
      });
    }
  </script>
