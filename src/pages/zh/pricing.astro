---
import LayoutZh from '../../layouts/LayoutZh.astro';
---
<LayoutZh title="GeoScore 定价 - 免费与专业版">
  <section class="max-w-5xl mx-auto py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
        简单<span class="gradient-text">透明</span>的定价
      </h1>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        单次审计永久免费。需要监控、历史记录或团队功能时再升级。
      </p>
    </div>

    <!-- Fix Pack：一次性代做服务，刻意放在订阅价格网格之外 -->
    <div class="card p-6 md:p-8 mb-12 border-brand-500/30 flex flex-col md:flex-row md:items-center gap-6">
      <div class="flex-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">一次性 · 代做</div>
        <h2 class="text-2xl font-bold mb-2">AI 可见度 Fix Pack — $49</h2>
        <p class="text-sm text-gray-400">
          不想自己动手？我们按你店铺的真实目录重写 llms.txt、为 robots.txt 写显式 AI 爬虫放行规则、
          补全一款畅销商品的 Product schema——部署后复检。人工制作、对照线上站点核对，48 小时交付。
        </p>
      </div>
      <div class="text-center shrink-0">
        <div class="text-4xl font-extrabold mb-1">$49</div>
        <div class="text-xs text-gray-500 mb-4">一次性 · 无订阅</div>
        <a id="fixpack-banner-cta" href="/zh/fixpack/" class="inline-block px-6 py-3 rounded-xl font-semibold text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 transition">查看包含什么 →</a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
      <!-- Free -->
      <div class="card p-6 flex flex-col">
        <div class="text-sm font-semibold text-gray-400 mb-2">Free</div>
        <div class="text-3xl font-extrabold mb-1">¥0</div>
        <div class="text-xs text-gray-500 mb-6">永久免费</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 单 URL 审计</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 11 维度，85 检查项</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 修复文件生成器</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> CLI & MCP Server</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 登录可选</li>
        </ul>
        <a href="/zh/#url-input" class="block text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-600 text-gray-300 hover:border-brand-500 hover:text-white transition">开始使用</a>
      </div>

      <!-- Pro -->
      <div class="card p-6 flex flex-col ring-2 ring-brand-500/50 relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full text-xs font-semibold bg-brand-500 text-white">热门</div>
        <div class="text-sm font-semibold text-brand-400 mb-2">Pro</div>
        <div class="text-xs text-gray-500 mb-6">价格含税</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-brand-500">✓</span> Free 全部功能</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 每周自动审计</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 30 天审计历史</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 回归告警</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> PDF 导出</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> AI 可见度估算——由大模型模拟 ChatGPT · Perplexity · Claude · Gemini 的回答，明确标注为估算，非真实引擎流量；每月 30 次</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 5 个域名</li>
        </ul>
        <!-- 月付与年付并排；各自发起对应的结账 -->
        <div class="grid grid-cols-2 gap-2">
          <button id="upgrade-pro" type="button" data-plan="pro" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5" class="rounded-lg border border-gray-700 hover:border-brand-500 p-2 text-left transition cursor-pointer">
            <span class="block text-lg font-extrabold">$9/mo</span>
            <span class="block text-xs text-gray-500">7 天免费试用</span>
          </button>
          <button id="upgrade-annual" type="button" data-plan="pro" data-billing="annual" data-checkout="https://www.creem.io/payment/prod_2OZLydXjeAKD3HyVY20eEN" class="rounded-lg border border-gray-700 hover:border-brand-500 p-2 text-left transition cursor-pointer">
            <span class="block text-lg font-extrabold">$79/yr</span>
            <span class="block text-xs font-semibold text-brand-400">立省 $29</span>
          </button>
        </div>
      </div>

      <!-- Studio -->
      <div class="card p-6 flex flex-col relative border-geo-500/30">
        <div class="text-sm font-semibold text-geo-400 mb-2">Studio</div>
        <div class="text-3xl font-extrabold mb-1">$29<span class="text-base font-normal text-gray-500">/月</span></div>
        <div class="text-xs text-gray-500 mb-6">7 天免费试用 · 价格含税</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Pro 全部功能</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 每日自动审计</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 12 个月审计历史</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 竞品对比</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 15 个域名</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> API 访问</li>
        </ul>
        <button id="upgrade-studio" type="button" data-plan="studio" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_yvmQsDZnoKHNXtDpJt51x" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 transition cursor-pointer">开始 7 天试用</button>
      </div>

      <!-- Agency -->
      <div class="card p-6 flex flex-col relative border-brand-500/30">
        <div class="text-sm font-semibold text-gray-400 mb-2">Agency</div>
        <div class="text-3xl font-extrabold mb-1">$59<span class="text-base font-normal text-gray-500">/月</span></div>
        <div class="text-xs text-gray-500 mb-6">7 天免费试用 · 价格含税</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Studio 全部功能</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 每小时审计</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 无限审计历史</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 团队工作区</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 50 个域名</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 白标 PDF 报告</li>
        </ul>
        <button id="upgrade-agency" type="button" data-plan="agency" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_7Itt3xoxDKLaItFqjfhv7x" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 text-white hover:border-brand-500 hover:bg-brand-500/10 transition cursor-pointer">开始 7 天试用</button>
      </div>
    </div>

    <!-- 对比表 -->
    <div class="card p-6 md:p-8 mb-12">
      <h2 class="text-xl font-bold mb-6 text-center">功能对比</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-700">
              <th scope="col" class="text-left py-3 text-gray-400 font-medium">功能</th>
              <th scope="col" class="text-center py-3 text-gray-400 font-medium">Free</th>
              <th scope="col" class="text-center py-3 text-brand-400 font-medium">Pro</th>
              <th scope="col" class="text-center py-3 text-geo-400 font-medium">Studio</th>
              <th scope="col" class="text-center py-3 text-gray-300 font-medium">Agency</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700/50">
            <tr><td class="py-2.5 text-gray-300">单 URL 审计</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">11 维度 85 检查项</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">修复文件生成器</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">CLI & MCP Server</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">自动审计</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">每周</td><td class="text-center text-gray-300">每日</td><td class="text-center text-gray-300">每小时</td></tr>
            <tr><td class="py-2.5 text-gray-300">审计历史</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">30 天</td><td class="text-center text-gray-300">12 个月</td><td class="text-center text-gray-300">无限</td></tr>
            <tr><td class="py-2.5 text-gray-300">回归告警</td><td class="text-center text-gray-400">—</td><td class="text-center">✓</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">PDF 导出</td><td class="text-center text-gray-400">—</td><td class="text-center">✓</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">竞品对比</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">API 访问</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">团队工作区</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">白标报告</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">域名数</td><td class="text-center text-gray-300">1</td><td class="text-center text-brand-400">5</td><td class="text-center text-geo-400">15</td><td class="text-center text-gray-300">50</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">价格</td><td class="text-center text-gray-300">¥0</td><td class="text-center text-brand-400">$9/月</td><td class="text-center text-geo-400">$29/月</td><td class="text-center text-gray-300">$59/月</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-6">定价常见问题</h2>
      <div class="space-y-4">
        <div class="card p-5">
          <h3 class="font-semibold mb-2">GeoScore 真的免费吗？</h3>
          <p class="text-sm text-gray-400">单次浏览器审计、CLI 和 MCP Server 免费。登录可选；Pro 监控和历史记录为付费功能。源代码以 MIT 协议开源在 GitHub。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">需要信用卡吗？</h3>
          <p class="text-sm text-gray-400">Free 计划无需信用卡。Pro、Studio 和 Agency 计划均包含 7 天免费试用，试用期结束后才会扣费；Pro 年付按年一次性支付 $79，不提供试用。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">可以随时取消吗？</h3>
          <p class="text-sm text-gray-400">可以。在客户门户随时取消，当前计费周期结束前保持访问权限。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">GeoScore 和闭源的 GEO 监测工具有什么不同？</h3>
          <p class="text-sm text-gray-400">GeoScore 是开源的（MIT）：提供 CLI 和 MCP Server，可指向任意 LLM 端点；免费浏览器审计还包含提示词注入检测。闭源监测套件按域名收月费，评分逻辑不公开。它们报告 AI 引擎如何提及你；GeoScore 审计的是你的站点为这些引擎提供了哪些可用素材——11 个维度，并附可直接应用的修复文件。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">你们处理 VAT 和税务吗？</h3>
          <p class="text-sm text-gray-400">是的。我们的支付合作伙伴 Creem 作为记录商户（MoR），自动处理 190+ 个国家的 VAT、GST 和销售税合规。您无需操心税务表格。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">可以帮我直接把修复做完吗？</h3>
          <p class="text-sm text-gray-400">可以。<a href="/zh/fixpack/" class="text-brand-400 hover:underline">AI 可见度 Fix Pack</a> 是一次性 $49 的代做服务：按你的目录定制 llms.txt、为 robots.txt 写显式 AI 爬虫放行规则、补全一款畅销商品的 Product schema、一页纸审计，部署后复检。通过 Fiverr Custom Offer 下单，先免费诊断，48 小时交付。</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Studio 和 Agency 计划可用吗？</h3>
          <p class="text-sm text-gray-400">是的。Studio（$29/月）和 Agency（$59/月）现已正式开放并包含 7 天免费试用。你可以直接订阅以获得更多监控域名、更高审计频率及团队工作区功能。</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'GeoScore 定价',
    description: 'GEO 审计工具，提供自动化监控、回归告警及 PDF 报告导出',
    brand: { '@type': 'Brand', name: 'GeoScore' },
    offers: [
      { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: '免费版', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', price: '9', priceCurrency: 'USD', name: 'Pro 月付', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5' },
      { '@type': 'Offer', price: '79', priceCurrency: 'USD', name: 'Pro 年付', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_2OZLydXjeAKD3HyVY20eEN' },
      { '@type': 'Offer', price: '29', priceCurrency: 'USD', name: 'Studio 月付', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_yvmQsDZnoKHNXtDpJt51x' },
      { '@type': 'Offer', price: '59', priceCurrency: 'USD', name: 'Agency 月付', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_7Itt3xoxDKLaItFqjfhv7x' },
      { '@type': 'Offer', price: '49', priceCurrency: 'USD', name: 'AI 可见度 Fix Pack（一次性代做）', availability: 'https://schema.org/InStock', url: 'https://geoscore.help/zh/fixpack/' }
    ]
  })} />

  <script>
    import { showToast } from '../../scripts/toast.js';
    // Pro / Studio / Agency 结账：每个计划/周期发起对应的 Creem 结账。
    // trial_started beacon 在跳转前触发（API 与静态链接两条路径都覆盖），
    // 避免页面卸载丢掉「点击→结账」这一步。
    async function startCheckout(btn) {
      const period = btn.getAttribute('data-billing') || 'monthly';
      const plan = btn.getAttribute('data-plan') || 'pro';
      const ctaId = btn.getAttribute('data-cta') || ('pricing_' + plan);
      const sourceType = window.geoSource ? window.geoSource() : 'other';
      if (window.geoTrack) {
        window.geoTrack('upgrade_cta_clicked', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType });
      }
      const token = localStorage.getItem('geoscore_token');
      if (!token) {
        try {
          localStorage.setItem('geoscore_pending_checkout', JSON.stringify({ plan: plan, period: period, ts: Date.now() }));
        } catch (e) { }
        if (window.geoscoreAuth) {
          window.geoscoreAuth.openAuthModal();
        } else {
          showToast('请先登录后再开始试用', 'info');
        }
        return;
      }
      const successUrl = location.origin + '/zh/pricing/?checkout=success';
      const leave = function (url) {
        if (window.geoTrack) {
          // transport_type beacon：紧接着页面就卸载了，必须用 sendBeacon 送出去。
          // checkout_started 标记「点击 → 进入 Creem」之间的一步，缺了它就看不到在哪流失。
          window.geoTrack('checkout_started', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType, transport_type: 'beacon' });
          window.geoTrack('trial_started', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType, transport_type: 'beacon' });
        }
        window.location.href = url;
      };
      const fallbackUrl = btn.getAttribute('data-checkout');
      // 为已登录用户创建绑定邮箱的 Creem 结账会话；
      // Worker API 不可用时回退到静态结账链接。
      if (window.geoscoreAuth && window.geoscoreAuth.api) {
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.textContent = '正在创建结账...';
        try {
          const res = await window.geoscoreAuth.api('/api/checkout', { method: 'POST', body: { plan: plan, billing_period: period, success_url: successUrl } });
          if (res.ok && res.data && res.data.checkout_url) {
            leave(res.data.checkout_url);
            return;
          }
        } catch (e) {
          // Worker 不可达或超时；回退到静态链接
        }
        btn.disabled = false;
        btn.innerHTML = original;
      }
      if (fallbackUrl) leave(fallbackUrl);
    }
    const planButtons = document.querySelectorAll('[data-billing]');
    for (let i = 0; i < planButtons.length; i++) {
      planButtons[i].addEventListener('click', function () { startCheckout(this); });
    }

    // Creem 付款后带 ?checkout=success 回到本页。每个会话只上报一次，
    // 刷新不得重复计入转化。
    if (new URLSearchParams(location.search).get('checkout') === 'success') {
      let alreadyReported = false;
      try {
        alreadyReported = sessionStorage.getItem('geoscore_checkout_returned') === '1';
        if (!alreadyReported) sessionStorage.setItem('geoscore_checkout_returned', '1');
      } catch (e) { /* storage 不可用：宁可上报也不要丢事件 */ }
      if (!alreadyReported && window.geoTrack) {
        window.geoTrack('checkout_returned', {
          source_type: window.geoSource ? window.geoSource() : 'other',
          transport_type: 'beacon',
        });
      }
      renderCheckoutSuccess();
    }

    function renderCheckoutSuccess() {
      const host = document.querySelector('section');
      if (!host || document.getElementById('checkout-success')) return;
      const box = document.createElement('div');
      box.id = 'checkout-success';
      box.setAttribute('role', 'status');
      box.className = 'card p-6 mb-8 border-geo-500/40 bg-geo-500/10';
      box.innerHTML =
        '<h2 class="text-lg font-bold text-white mb-2">付款成功，订阅已生效</h2>' +
        '<p class="text-sm text-gray-300 mb-4">' +
          '你的账号已升级。监控面板在首页，跑一次审计后即可看到监控、历史与 AI 可见度。' +
        '</p>' +
        '<a href="/zh/#pro-monitor-root" class="inline-block px-4 py-2 rounded-lg bg-geo-500 hover:bg-geo-600 text-white text-sm font-semibold transition">' +
          '打开监控面板 →' +
        '</a>';
      host.insertBefore(box, host.firstChild);
    }

    // 恢复因登录流程中断的结账
    (function resumePendingCheckout() {
      let pending = null;
      try {
        pending = JSON.parse(localStorage.getItem('geoscore_pending_checkout') || 'null');
        localStorage.removeItem('geoscore_pending_checkout');
      } catch (e) { return; }
      if (!pending || !pending.period) return;
      if (!localStorage.getItem('geoscore_token')) return;
      if (Date.now() - pending.ts > 10 * 60 * 1000) return;
      const selector = pending.plan
        ? '[data-plan="' + pending.plan + '"][data-billing="' + pending.period + '"]'
        : '[data-billing="' + pending.period + '"]';
      const btn = document.querySelector(selector) || document.querySelector('[data-billing="' + pending.period + '"]');
      if (btn) startCheckout(btn);
    })();

    // 漏斗埋点（2026-10-23 重造补齐）：定价页此前没有浏览事件，付费漏斗顶部不可测。
    if (window.geoTrack) {
      window.geoTrack('pricing_viewed', { source_type: window.geoSource ? window.geoSource() : 'other' });
    }
    const fixpackCta = document.getElementById('fixpack-banner-cta');
    if (fixpackCta) {
      fixpackCta.addEventListener('click', function () {
        if (window.geoTrack) window.geoTrack('fixpack_cta_clicked', { placement: 'pricing_banner', transport_type: 'beacon' });
      });
    }
  </script>
