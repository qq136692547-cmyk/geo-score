---
import LayoutZh from '../../../layouts/LayoutZh.astro';
import demo from '../../../../data/demo-report.json';

// 进度条颜色由真实百分比决定。这些必须是字面量字符串，Tailwind 扫描源码时
// 才能找到——不要用字符串拼接生成类名。
const barColor = (pct) => (pct >= 80 ? 'bg-geo-500' : pct >= 50 ? 'bg-warn-500' : 'bg-danger-500');

const levelLabel = { Excellent: '优秀', Good: '良好', Basic: '基础', Critical: '严重' };
const auditDate = new Date(demo.generatedAt).toISOString().slice(0, 10);
const botsAllowed = demo.aiBots.filter((b) => b.allowed).length;
const botsBlocked = demo.aiBots.filter((b) => !b.allowed);
const piNote = demo.promptInjectionFlags > 0
  ? ` 提示注入检测：${demo.promptInjectionFlags} 项标记，-${demo.promptInjectionPoints} 分。`
  : '';
const botsNote = botsBlocked.length > 0
  ? ` 已阻止：${botsBlocked.map((b) => b.bot).join('、')}。`
  : ' 无任何爬虫被阻止。';
---
<LayoutZh title="示例审计报告 — GeoScore | GeoScore"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'GeoScore 示例审计报告 — 网站分析样本',
    description: '了解 GeoScore 如何审计真实网站。此示例报告展示了全部 11 个维度、20 个 AI 爬虫检测和修复建议。',
    url: 'https://geoscore.help/zh/report/demo/',
    author: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    datePublished: '2026-08-11',
    dateModified: '2026-08-11'
  }}
>
  <section class="max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-geo-500/10 text-geo-400 border border-geo-500/20 mb-4">
        示例报告
      </div>
      <h1 class="text-4xl font-extrabold mb-3">示例审计报告</h1>
      <p class="text-gray-400 max-w-2xl mx-auto">了解完整 GeoScore 审计的样子 — 11 个维度、20 个 AI 爬虫检测、修复文件和建议。</p>
    </div>

    <!-- 报告头部 -->
    <div class="card p-6 mb-6">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <p class="text-sm text-gray-500">审计 URL</p>
          <p class="text-lg font-mono text-white">{demo.host}</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-extrabold text-geo-500">{demo.score}</div>
          <div class="text-xs font-semibold text-geo-400 mt-1">{levelLabel[demo.level] || demo.level}</div>
        </div>
        <div class="text-right">
          <p class="text-sm text-gray-500">审计日期</p>
          <p class="text-sm text-gray-300">{auditDate}</p>
        </div>
      </div>
      <div class="mt-4 p-3 rounded-lg bg-white/5 text-sm text-gray-400">
        得分 {demo.score}/100（{levelLabel[demo.level] || demo.level}）。{demo.dimensionCount} 个维度中 {demo.dimensionsAboveSixty} 个超过 60%。检测到 {demo.negativeSignals} 个负面信号，{demo.promptInjectionFlags} 个提示注入标记。
      </div>
      <p class="mt-3 text-xs text-gray-500">
        以下为真实结果：GeoScore 于 {auditDate} 扫描了 {demo.host}。可用 <code class="font-mono text-gray-400">node tools/refresh-demo-report.mjs</code> 重新生成。
      </p>
    </div>

    <!-- 维度明细 -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">维度明细</h2>
      <div class="space-y-3">
        {demo.dimensions.map(d => (
          <div>
            <div class="flex items-center justify-between text-sm mb-1">
              <span class="text-gray-300">{d.labelZh}</span>
              <span class="text-gray-500 font-mono">{d.score}/{d.maxScore} &middot; {d.pct}% <span class="text-gray-400">(权重 &times;{d.weight})</span></span>
            </div>
            <div class="w-full h-2 rounded-full bg-gray-700/50 overflow-hidden">
              <div class={`h-full rounded-full ${barColor(d.pct)}`} style={`width:${d.pct}%`}></div>
            </div>
          </div>
        ))}
        <div class="pt-2 border-t border-gray-700/50">
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-300">负面信号</span>
            <span class="text-danger-400 font-mono">-{demo.negativeSignalPoints} 分</span>
          </div>
          <p class="text-xs text-gray-500 mt-1">
            检测到 {demo.negativeSignals} 项扣分。{piNote}
          </p>
        </div>
      </div>
    </div>

    <!-- AI 爬虫检测详情 -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">AI 爬虫检测（20 个）</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        {demo.aiBots.map(c => (
          <div class={`flex items-center gap-2 p-2 rounded-lg text-sm ${c.allowed ? 'bg-geo-500/5' : 'bg-danger-500/5'}`}>
            <span class={`w-2 h-2 rounded-full ${c.allowed ? 'bg-geo-500' : 'bg-danger-500'}`}></span>
            <span class="font-mono text-gray-300">{c.bot}</span>
            <span class="text-gray-400 text-xs ml-auto">{c.tier}</span>
            <span class={`text-xs font-semibold ${c.allowed ? 'text-geo-400' : 'text-danger-400'}`}>{c.allowed ? '已允许' : '已阻止'}</span>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-500 mt-3">
        {demo.aiBots.length} 个 AI 爬虫中 {botsAllowed} 个已允许。{botsNote}
      </p>
    </div>

    <!-- 优先建议 -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">优先修复建议</h2>
      <div class="space-y-3">
        {demo.recommendations.map(r => (
          <div class="flex items-start gap-3 p-3 rounded-lg bg-white/5">
            <span class={`px-2 py-0.5 rounded text-xs font-bold ${r.priority === 'P0' ? 'bg-danger-500/20 text-danger-400' : r.priority === 'P1' ? 'bg-warn-500/20 text-warn-400' : 'bg-gray-500/20 text-gray-400'}`}>{r.priority}</span>
            <span class="text-sm text-gray-300 flex-1">{r.text}</span>
            <span class="text-xs text-geo-400 font-mono whitespace-nowrap">{r.impact}</span>
          </div>
        ))}
        <p class="text-xs text-gray-500 mt-3">共 {demo.recommendationCount} 条建议，此处展示优先级最高的 {demo.recommendations.length} 条。右侧为提出该建议的维度。</p>
      </div>
    </div>

    <!-- 自动生成的修复文件 -->
    <div class="card p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">自动生成的修复文件</h2>
      <p class="text-gray-400 text-sm mb-4">GeoScore 根据审计结果生成三个可直接部署的文件：</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">📄</div>
          <h3 class="text-sm font-semibold text-white">llms.txt</h3>
          <p class="text-xs text-gray-500 mt-1">AI 引导文件，包含网站摘要和关键链接</p>
        </div>
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">🤖</div>
          <h3 class="text-sm font-semibold text-white">robots.txt</h3>
          <p class="text-xs text-gray-500 mt-1">AI 爬虫友好的 robots.txt，允许 20 个爬虫</p>
        </div>
        <div class="p-4 rounded-lg bg-white/5 text-center">
          <div class="text-2xl mb-2">🔧</div>
          <h3 class="text-sm font-semibold text-white">JSON-LD</h3>
          <p class="text-xs text-gray-500 mt-1">用于你 &lt;head&gt; 部分的结构化数据代码</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center py-8">
      <h2 class="text-2xl font-bold mb-3">运行你自己的审计</h2>
      <p class="text-gray-400 mb-6">查看你的网站在 11 个维度和 20 个 AI 爬虫上的表现。免费，无需注册。</p>
      <a href="/zh/" class="inline-block px-8 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 transition shadow-lg shadow-brand-500/20">开始免费审计</a>
    </div>
  </section>
</LayoutZh>
