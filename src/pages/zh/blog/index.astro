---
import LayoutZh from '../../../layouts/LayoutZh.astro';

const posts = [
  { zhUrl: '/zh/blog/geoscore-v1-9-live-badges-stack-detection/', title: 'GeoScore v1.9 发布：实时 SVG 评分徽章、技术栈自动识别、平台指南与 WorkBuddy 专家团', tag: '发布 v1.9 · 6 分钟', excerpt: '支持实时动态 GEO 评分 SVG 徽章一键嵌入 README 与官网页脚，Chrome 扩展 v1.9.0 自动识别 Shopify/WordPress/Next.js 技术栈，并正式上架腾讯 WorkBuddy 国内企业专家团（¥29 买断）。' },
  { zhUrl: '/zh/blog/enterprise-geo-china-kimi-doubao-metaso/', title: '2026 国内企业官网 GEO 引文实战指南：如何让 Kimi、豆包、秘塔 AI 优先引用你的企业？', tag: '指南 · 12 分钟', excerpt: '大模型时代传统 SEO 全面失效。深度拆解国内主流 AI 搜索（Kimi、豆包、秘塔、文心一言、通义千问）的引文检索算法，详解统一社会信用代码、ICP/网安合规、防软 404 与知识库架构等 11 维 85 项核心指标。' },
  { zhUrl: '/zh/blog/geoscore-chrome-extension-launch/', title: 'GeoScore 官方 Chrome 扩展正式上线：突破 WAF 限制，在浏览器侧边栏一键深度审计 AI 就绪度', tag: '发布 · 8 分钟', excerpt: '告别云端爬虫被 Cloudflare 拦截与内网无法测试的困扰。基于 Manifest V3 与 Chrome Side Panel，零配置在任意前台网页一键审计 11 维 85 项 AI 引文关键指标。' },
  { zhUrl: '/zh/blog/geoscore-update-multi-page-security/', title: 'GeoScore 引擎升级：多页面扫描、HTTP 安全头与中文深度支持', tag: '更新 · 7 分钟', excerpt: '核心引擎重大升级：自动聚合子页面结构化数据、直接校验 HTTP 响应头 HSTS/CSP，以及 CJK 中文全套评分规则优化。' },
];
---
<LayoutZh title="GEO 博客与指南 | GeoScore"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'GeoScore 博客',
    description: '关于生成式引擎优化（GEO）、AI 搜索可见性、结构化数据和 llms.txt 的深度指南。',
    url: 'https://geoscore.help/zh/blog/',
    publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' }
  }}
>
  <section class="max-w-4xl mx-auto py-12">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-geo-500/10 text-geo-400 border border-geo-500/20 mb-4">
        GeoScore 博客
      </div>
      <h1 class="text-4xl font-extrabold mb-3">GEO 指南与文章</h1>
      <p class="text-gray-400 max-w-2xl mx-auto">关于生成式引擎优化、AI 搜索可见性、结构化数据以及如何让 ChatGPT、Perplexity 和 Claude 引用你内容的深度指南。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {posts.filter(p => p.tag !== '重定向').map((post) => (
        <a href={post.zhUrl} class="card card-hover card-lift p-6 block">
          <div class="text-xs text-gray-500 mb-2">{post.tag}</div>
          <h2 class="text-lg font-bold mb-2">{post.title}</h2>
          <p class="text-gray-400 text-sm">{post.excerpt}</p>
        </a>
      ))}
    </div>
    <p class="text-center text-sm text-gray-500 mt-8">更多中文指南正在翻译中，英文版全集见 <a href="/blog/" class="text-brand-400 hover:underline">GeoScore Blog</a>。</p>
  </section>
</LayoutZh>
