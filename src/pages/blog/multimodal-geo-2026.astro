    headline: 'Multimodal GEO 2026: Optimizing Images, Video & Audio for AI Search',
    description: 'AI search engines now read images, watch video, and transcribe audio. Learn the 2026 multimodal GEO playbook: image alt + structured data, video transcripts, and audio metadata that gets your non-text content cited by ChatGPT, Perplexity, and Gemini.',
    url: 'https://geoscore.help/blog/multimodal-geo-2026/',
    datePublished: '2026-08-01',
    dateModified: '2026-08-01',
    author: { '@type': 'Organization', name: 'GeoScore' },
    publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    keywords: 'multimodal GEO, image SEO for AI, video transcript optimization, audio metadata, AI search visibility, generative engine optimization'
  }}
>
