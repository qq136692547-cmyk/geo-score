---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="GeoScore Pro Sandbox (Test Mode)">
  <section class="max-w-3xl mx-auto py-12 px-4">
    <div class="mb-8 rounded-xl border-2 border-amber-500/60 bg-amber-500/10 p-4 text-sm text-amber-300">
      <strong>Sandbox 测试页 — 勿公开分享。</strong> 此按钮连接 Creem <strong>测试模式</strong>（test-api），
      使用测试卡 <code class="bg-black/30 px-1 rounded">4111 1111 1111 1111</code>（有效期任意未来日期、CVV 任意三位）
      不会产生真实扣款。生产用户请使用 <a href="/pricing" class="underline text-amber-200">/pricing</a> 正式按钮。
    </div>

    <h1 class="text-3xl font-extrabold mb-2">GeoScore Pro — 沙箱支付测试</h1>
    <p class="text-gray-400 mb-8">验证 Creem embed 支付 → webhook → 订阅激活 全链路。</p>

    <div class="card p-6">
      <div class="text-sm font-semibold text-brand-400 mb-2">Pro (Test)</div>
      <div class="text-3xl font-extrabold mb-1">$9<span class="text-base font-normal text-gray-500">/mo</span></div>
      <p class="text-sm text-gray-400 mb-6">7-day free trial · Test Mode · USD 9.00/月</p>

      <script is:inline src="https://www.creem.io/embed.js" async></script>
      <a href="https://www.creem.io/test/payment/prod_2XAiNzkFvZPQxuczWV462U"
         data-creem-checkout
         data-creem-theme="light"
         style="display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:12px;border:2px solid #151617;background:#FFBE98;color:#151617;box-shadow:3px 3px 0 0 #151617;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;line-height:1;cursor:pointer;text-decoration:none">
        <svg width="15" height="15" viewBox="0 0 121 121" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block;flex:0 0 auto"><path d="M22.1102 11C24.1187 11 25.9669 12.0982 26.9281 13.8619L51.2059 58.4106C52.5699 60.9134 55.7048 61.8368 58.2077 60.473C60.7108 59.109 61.6342 55.9742 60.2701 53.4712L41.5466 19.113C39.554 15.4566 42.2004 11 46.3645 11H103.806C107.885 11 110.539 15.2933 108.715 18.9416L65.0579 106.254C63.0356 110.298 57.2654 110.298 55.2431 106.254L11.5863 18.9416C9.76212 15.2933 12.4156 11 16.4946 11H22.1102Z" fill="#151617"/></svg>
        <span>Buy with Creem (Test)</span>
      </a>
    </div>

    <div id="result" class="mt-6 hidden text-sm rounded-xl border border-geo-500/40 bg-geo-500/10 p-4 text-geo-300"></div>
  </section>

  <script is:inline>
    window.addEventListener('message', function (e) {
      const d = e.data;
      if (d && d.source === 'creem-embed' && d.type === 'completed') {
        const el = document.getElementById('result');
        if (el) {
          el.classList.remove('hidden');
          el.textContent = '支付完成：订单 ' + (d.orderNo || d.orderId || '?') + '。正在返回商户页面…';
        }
      }
    });
  </script>
</Layout>
