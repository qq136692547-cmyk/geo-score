---
import Layout from '../layouts/Layout.astro';
---
<Layout title="GeoScore Pricing - Free & Pro Plans" schema={{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // 这份 mainEntity 必须与页面下方 "Pricing FAQ" 区块逐条对齐。
  // 之前的版本声明了 'Is GeoScore free?' 与 'What is included in the Pro plan?'，
  // 但页面上显示的是另外一组问题——schema 里的答案用户看不到，属于不一致，
  // 会被判为无资格显示富媒体结果。tests/faq-schema-consistency.test.js 守住这条。
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is GeoScore really free?',
      acceptedAnswer: { '@type': 'Answer', text: 'Single browser audits, the CLI, and the MCP Server are free. Sign-in is optional; Pro monitoring and history are paid. The source code is MIT-licensed on GitHub.' }
    },
    {
      '@type': 'Question',
      name: 'Do I need a credit card to start?',
      acceptedAnswer: { '@type': 'Answer', text: 'No credit card required for the Free plan. Pro monthly includes a 7-day free trial — your card is only charged after the trial ends. Pro annual is paid upfront for $79 and does not include a trial.' }
    },
    {
      '@type': 'Question',
      name: 'Can I cancel anytime?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Cancel anytime from the customer portal. You keep access until the end of your billing period.' }
    },
    {
      '@type': 'Question',
      name: 'How is GeoScore different from GeoReady?',
      acceptedAnswer: { '@type': 'Answer', text: 'GeoScore is open-source (MIT), supports Chinese, includes CLI and MCP Server, and offers prompt injection detection in its free browser audit. GeoReady charges $9-89/month for similar monitoring features.' }
    },
    {
      '@type': 'Question',
      name: 'Do you handle VAT and taxes?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. As a Merchant of Record, our payment partner Creem handles VAT, GST, and sales tax compliance in 190+ countries.' }
    },
    {
      '@type': 'Question',
      name: 'Can you just do the fixes for me?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. The AI Visibility Fix Pack is a one-time $49 done-for-you service: a custom llms.txt built from your catalog, explicit AI-crawler rules for robots.txt, Product schema for one best-seller, a 1-page audit, and a re-audit after you deploy. Delivered in 48 hours via Fiverr Custom Offer, with a free diagnosis first.' }
    },
    {
      '@type': 'Question',
      name: 'When will Studio and Agency be available?',
      acceptedAnswer: { '@type': 'Answer', text: 'Studio and Agency are coming soon. We are launching with Pro first to validate the workflow. Watch our GitHub repository for updates.' }
    }
  ]
}}>
  <section class="max-w-5xl mx-auto py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
        Simple, <span class="gradient-text">transparent</span> pricing
      </h1>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Free forever for single audits. Upgrade when you need monitoring, history, or team features.
      </p>
    </div>

    <!-- Fix Pack: one-time done-for-you service, deliberately outside the subscription grid -->
    <div class="card p-6 md:p-8 mb-12 border-brand-500/30 flex flex-col md:flex-row md:items-center gap-6">
      <div class="flex-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">One-time · Done for you</div>
        <h2 class="text-2xl font-bold mb-2">AI Visibility Fix Pack — $49</h2>
        <p class="text-sm text-gray-400">
          Don't want to DIY? We rebuild your llms.txt from your real catalog, write explicit AI-crawler rules
          for robots.txt, and complete Product schema for your best-seller — then re-audit after you deploy.
          Human-made, checked against your live site, delivered in 48 hours.
        </p>
      </div>
      <div class="text-center shrink-0">
        <div class="text-4xl font-extrabold mb-1">$49</div>
        <div class="text-xs text-gray-500 mb-4">one-time · no subscription</div>
        <a id="fixpack-banner-cta" href="/fixpack/" class="inline-block px-6 py-3 rounded-xl font-semibold text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 transition">See what's included →</a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
      <!-- Free -->
      <div class="card p-6 flex flex-col">
        <div class="text-sm font-semibold text-gray-400 mb-2">Free</div>
        <div class="text-3xl font-extrabold mb-1">$0</div>
        <div class="text-xs text-gray-500 mb-6">forever</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Single URL audit</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 11 dimensions, 85 checks</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Fix file generator</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> CLI & MCP Server</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Sign-in optional</li>
        </ul>
        <a href="/#url-input" class="block text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-600 text-gray-300 hover:border-brand-500 hover:text-white transition">Start Free</a>
      </div>

      <!-- Pro -->
      <div class="card p-6 flex flex-col ring-2 ring-brand-500/50 relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full text-xs font-semibold bg-brand-500 text-white">Popular</div>
        <div class="text-sm font-semibold text-brand-400 mb-2">Pro</div>
        <div class="text-xs text-gray-500 mb-6">Taxes included</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-brand-500">✓</span> Everything in Free</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> Weekly automated audits</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 30-day audit history</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> Regression alerts</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> PDF export</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> AI visibility estimate — LLM-simulated answers (ChatGPT · Perplexity · Claude · Gemini), labelled as estimates, not live engine traffic; 30 runs/month</li>
          <li class="flex gap-2"><span class="text-brand-500">✓</span> 5 domains</li>
        </ul>
        <!-- Monthly and annual side by side; each option starts its own checkout -->
        <div class="grid grid-cols-2 gap-2">
          <button id="upgrade-pro" type="button" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5" class="rounded-lg border border-gray-700 hover:border-brand-500 p-2 text-left transition cursor-pointer">
            <span class="block text-lg font-extrabold">$9/mo</span>
            <span class="block text-xs text-gray-500">7-day free trial</span>
          </button>
          <button id="upgrade-annual" type="button" data-billing="annual" data-checkout="https://www.creem.io/payment/prod_2OZLydXjeAKD3HyVY20eEN" class="rounded-lg border border-gray-700 hover:border-brand-500 p-2 text-left transition cursor-pointer">
            <span class="block text-lg font-extrabold">$79/yr</span>
            <span class="block text-xs font-semibold text-brand-400">Save $29</span>
          </button>
        </div>
      </div>

      <!-- Studio (Coming Soon) -->
      <div class="card p-6 flex flex-col opacity-50 cursor-not-allowed relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full text-xs font-semibold bg-gray-700 text-gray-300">Coming Soon</div>
        <div class="text-sm font-semibold text-geo-400 mb-2">Studio</div>
        <div class="text-3xl font-extrabold mb-1">$29<span class="text-base font-normal text-gray-500">/mo</span></div>
        <div class="text-xs text-gray-500 mb-6">7-day free trial</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Everything in Pro</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Daily automated audits</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 12-month audit history</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Competitor comparison</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 15 domains</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> API access</li>
        </ul>
        <button disabled class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 text-gray-500 cursor-not-allowed">Coming Soon</button>
      </div>

      <!-- Agency (Coming Soon) -->
      <div class="card p-6 flex flex-col opacity-50 cursor-not-allowed relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full text-xs font-semibold bg-gray-700 text-gray-300">Coming Soon</div>
        <div class="text-sm font-semibold text-gray-400 mb-2">Agency</div>
        <div class="text-3xl font-extrabold mb-1">$59<span class="text-base font-normal text-gray-500">/mo</span></div>
        <div class="text-xs text-gray-500 mb-6">7-day free trial</div>
        <ul class="text-sm text-gray-400 space-y-2 mb-6 flex-1">
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Everything in Studio</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Hourly audits</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Unlimited audit history</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> Team workspace</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> 50 domains</li>
          <li class="flex gap-2"><span class="text-geo-500">✓</span> White-label PDF reports</li>
        </ul>
        <button disabled class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 text-gray-500 cursor-not-allowed">Coming Soon</button>
      </div>
    </div>

    <!-- Comparison table -->
    <div class="card p-6 md:p-8 mb-12">
      <h2 class="text-xl font-bold mb-6 text-center">Feature Comparison</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-700">
              <th scope="col" class="text-left py-3 text-gray-400 font-medium">Feature</th>
              <th scope="col" class="text-center py-3 text-gray-400 font-medium">Free</th>
              <th scope="col" class="text-center py-3 text-brand-400 font-medium">Pro</th>
              <th scope="col" class="text-center py-3 text-gray-500 font-medium">Studio <span class="text-xs">(soon)</span></th>
              <th scope="col" class="text-center py-3 text-gray-500 font-medium">Agency <span class="text-xs">(soon)</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700/50">
            <tr><td class="py-2.5 text-gray-300">Single URL audit</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">11 dimensions, 85 checks</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">Fix file generator</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">CLI & MCP Server</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">Automated audits</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">Weekly</td><td class="text-center text-gray-500">Daily</td><td class="text-center text-gray-500">Hourly</td></tr>
            <tr><td class="py-2.5 text-gray-300">Audit history</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">30 days</td><td class="text-center text-gray-500">12 months</td><td class="text-center text-gray-500">Unlimited</td></tr>
            <tr><td class="py-2.5 text-gray-300">Regression alerts</td><td class="text-center text-gray-400">—</td><td class="text-center">✓</td><td class="text-center text-gray-500">✓</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">PDF export</td><td class="text-center text-gray-400">—</td><td class="text-center">✓</td><td class="text-center text-gray-500">✓</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">Competitor comparison</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-500">✓</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">API access</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-500">✓</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">Team workspace</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-500">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">White-label reports</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-500">✓</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">Domains</td><td class="text-center text-gray-300">1</td><td class="text-center text-brand-400">5</td><td class="text-center text-gray-500">15</td><td class="text-center text-gray-500">50</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">Price</td><td class="text-center text-gray-300">$0</td><td class="text-center text-brand-400">$9/mo</td><td class="text-center text-gray-500">$29/mo</td><td class="text-center text-gray-500">$59/mo</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-6">Pricing FAQ</h2>
      <div class="space-y-4">
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Is GeoScore really free?</h3>
          <p class="text-sm text-gray-400">Single browser audits, the CLI, and the MCP Server are free. Sign-in is optional; Pro monitoring and history are paid. The source code is MIT-licensed on GitHub.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Do I need a credit card to start?</h3>
          <p class="text-sm text-gray-400">No credit card required for the Free plan. Pro monthly includes a 7-day free trial — your card is only charged after the trial ends. Pro annual is paid upfront for $79 and does not include a trial.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Can I cancel anytime?</h3>
          <p class="text-sm text-gray-400">Yes. Cancel anytime from the customer portal. You keep access until the end of your billing period.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">How is GeoScore different from GeoReady?</h3>
          <p class="text-sm text-gray-400">GeoScore is open-source (MIT), supports Chinese, includes CLI and MCP Server, and offers prompt injection detection in its free browser audit. GeoReady charges $9-89/month for similar monitoring features.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Do you handle VAT and taxes?</h3>
          <p class="text-sm text-gray-400">Yes. As a Merchant of Record, our payment partner Creem handles VAT, GST, and sales tax compliance in 190+ countries. You don't need to worry about tax forms.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Can you just do the fixes for me?</h3>
          <p class="text-sm text-gray-400">Yes. The <a href="/fixpack/" class="text-brand-400 hover:underline">AI Visibility Fix Pack</a> is a one-time $49 done-for-you service: a custom llms.txt built from your catalog, explicit AI-crawler rules for robots.txt, Product schema for one best-seller, a 1-page audit, and a re-audit after you deploy. Delivered in 48 hours via Fiverr Custom Offer, with a free diagnosis first.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">When will Studio and Agency be available?</h3>
          <p class="text-sm text-gray-400">Studio and Agency are coming soon. We're launching with Pro first to validate the workflow. Watch our <a href="https://github.com/qq136692547-cmyk/geo-score" class="text-brand-400 hover:underline">GitHub repository</a> for updates.</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'GeoScore Pro',
    description: 'GEO audit tool with automated monitoring, regression alerts, and PDF export',
    brand: { '@type': 'Brand', name: 'GeoScore' },
    offers: [
      { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', price: '9', priceCurrency: 'USD', name: 'Pro monthly', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5' },
      { '@type': 'Offer', price: '79', priceCurrency: 'USD', name: 'Pro annual', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_2OZLydXjeAKD3HyVY20eEN' },
      { '@type': 'Offer', price: '49', priceCurrency: 'USD', name: 'AI Visibility Fix Pack (one-time service)', availability: 'https://schema.org/InStock', url: 'https://geoscore.help/fixpack/' }
    ]
  })} />
</Layout>

<script>
  import { showToast } from '../scripts/toast.js';
  // Pro checkout: monthly and annual are separate Creem products, so the button
  // carries the period and the Worker maps it to a product id. The trial_started
  // beacon fires right before navigation (API path and static fallback alike) so
  // the CTA -> checkout step is not lost when the browser leaves the page.
  async function startCheckout(btn) {
    const period = btn.getAttribute('data-billing') || 'monthly';
    const sourceType = window.geoSource ? window.geoSource() : 'other';
    if (window.geoTrack) {
      window.geoTrack('upgrade_cta_clicked', { cta_id: 'pricing_pro', billing_period: period, source_type: sourceType });
    }
    const token = localStorage.getItem('geoscore_token');
    if (!token) {
      // 2026-10-23: remember which plan they picked. The login flow reloads the
      // page, so without this the user had to find and click the price again.
      try {
        localStorage.setItem('geoscore_pending_checkout', JSON.stringify({ period: period, ts: Date.now() }));
      } catch (e) { /* storage blocked: the old double-click flow still works */ }
      if (window.geoscoreAuth) {
        window.geoscoreAuth.openAuthModal();
      } else {
        showToast('Please sign in first to start your free trial.', 'info');
      }
      return;
    }
    const successUrl = location.origin + '/pricing/?checkout=success';
    const leave = function (url) {
      if (window.geoTrack) {
        // transport_type beacon: the page unloads right after this, so the event
        // must survive on sendBeacon instead of a normal gtag round trip.
        // checkout_started marks the funnel step between CTA click and Creem:
        // without it, "clicked but never reached checkout" was invisible.
        window.geoTrack('checkout_started', { cta_id: 'pricing_pro', billing_period: period, source_type: sourceType, transport_type: 'beacon' });
        window.geoTrack('trial_started', { cta_id: 'pricing_pro', billing_period: period, source_type: sourceType, transport_type: 'beacon' });
      }
      window.location.href = url;
    };
    const fallbackUrl = btn.getAttribute('data-checkout');
    // Create a Creem checkout session bound to this account via the Worker;
    // fall back to the static checkout link if the API is unavailable.
    if (window.geoscoreAuth && window.geoscoreAuth.api) {
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = 'Preparing checkout...';
      try {
        const res = await window.geoscoreAuth.api('/api/checkout', { method: 'POST', body: { billing_period: period, success_url: successUrl } });
        if (res.ok && res.data && res.data.checkout_url) {
          leave(res.data.checkout_url);
          return;
        }
      } catch (e) {
        // Worker unreachable or timeout; fall through to the static link
      }
      btn.disabled = false;
      btn.innerHTML = original;
    }
    if (fallbackUrl) leave(fallbackUrl);
  }
  const planButtons = document.querySelectorAll('[data-billing]');
  for (let i = 0; i < planButtons.length; i++) {
    planButtons[i].addEventListener('click', function () { startCheckout(this); });
  }

  // Creem sends the buyer back here with ?checkout=success. Report it once per
  // session: a refresh must not re-report the same conversion.
  if (new URLSearchParams(location.search).get('checkout') === 'success') {
    let alreadyReported = false;
    try {
      alreadyReported = sessionStorage.getItem('geoscore_checkout_returned') === '1';
      if (!alreadyReported) sessionStorage.setItem('geoscore_checkout_returned', '1');
    } catch (e) { /* storage unavailable: report anyway rather than lose the event */ }
    if (!alreadyReported && window.geoTrack) {
      window.geoTrack('checkout_returned', {
        source_type: window.geoSource ? window.geoSource() : 'other',
        transport_type: 'beacon',
      });
    }
    // 2026-10-23: this used to fire an event and change nothing visible. A buyer
    // landed back on the same four plan cards with no confirmation that the
    // payment worked — the highest-intent moment in the funnel was a blank.
    renderCheckoutSuccess();
  }

  function renderCheckoutSuccess() {
    const host = document.querySelector('section');
    if (!host || document.getElementById('checkout-success')) return;
    const zh = (document.documentElement.lang || 'en').toLowerCase().indexOf('zh') === 0;
    const box = document.createElement('div');
    box.id = 'checkout-success';
    box.setAttribute('role', 'status');
    box.className = 'card p-6 mb-8 border-geo-500/40 bg-geo-500/10';
    box.innerHTML =
      '<h2 class="text-lg font-bold text-white mb-2">' +
        (zh ? '付款成功，Pro 已生效' : 'Payment received — Pro is active') +
      '</h2>' +
      '<p class="text-sm text-gray-300 mb-4">' +
        (zh
          ? '你的账号已升级。Pro 面板在首页，跑一次审计后即可看到监控、历史与 AI 可见度。'
          : 'Your account is upgraded. The Pro panel lives on the home page — run one audit and monitoring, history and AI visibility open up.') +
      '</p>' +
      '<a href="/' + (zh ? 'zh/' : '') + '#pro-monitor-root" class="inline-block px-4 py-2 rounded-lg bg-geo-500 hover:bg-geo-600 text-white text-sm font-semibold transition">' +
        (zh ? '打开 Pro 面板 →' : 'Open the Pro panel →') +
      '</a>';
    host.insertBefore(box, host.firstChild);
  }

  // Resume a checkout that was interrupted by the sign-in flow. Both auth paths
  // in public/scripts/auth.js end with location.reload(), so the only reliable
  // place to continue is page load.
  (function resumePendingCheckout() {
    let pending = null;
    try {
      pending = JSON.parse(localStorage.getItem('geoscore_pending_checkout') || 'null');
      localStorage.removeItem('geoscore_pending_checkout');
    } catch (e) { return; }
    if (!pending || !pending.period) return;
    if (!localStorage.getItem('geoscore_token')) return;
    if (Date.now() - pending.ts > 10 * 60 * 1000) return;
    const btn = document.querySelector('[data-billing="' + pending.period + '"]');
    if (btn) startCheckout(btn);
  })();

  // Funnel instrumentation (2026-10-23 rebuild): the pricing page itself had no
  // view event, so the top of the paid funnel could not be measured at all.
  if (window.geoTrack) {
    window.geoTrack('pricing_viewed', { source_type: window.geoSource ? window.geoSource() : 'other' });
  }
  const fixpackCta = document.getElementById('fixpack-banner-cta');
  if (fixpackCta) {
    fixpackCta.addEventListener('click', function () {
      if (window.geoTrack) window.geoTrack('fixpack_cta_clicked', { placement: 'pricing_banner', transport_type: 'beacon' });
    });
  }
</script>
