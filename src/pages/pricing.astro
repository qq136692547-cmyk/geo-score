---
import Layout from '../layouts/Layout.astro';
---
<Layout title="GeoScore Pricing - Free & Pro Plans" schema={{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // 这份 mainEntity 必须与页面下方 "Pricing FAQ" 区块逐条对齐。
  // 之前的版本声明了 'Is GeoScore free?' 与 'What is included in the Pro plan?'，
  // 但页面上显示的是另外一组问题——schema 里的答案用户看不到，属于不一致，
  // 会被判为无资格显示富媒体结果。tests/faq-schema-consistency.test.js 守住这条。
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is GeoScore really free?',
      acceptedAnswer: { '@type': 'Answer', text: 'Single browser audits, the CLI, and the MCP Server are free. Sign-in is optional; Pro monitoring and history are paid. The source code is MIT-licensed on GitHub.' }
    },
    {
      '@type': 'Question',
      name: 'Do I need a credit card to start?',
      acceptedAnswer: { '@type': 'Answer', text: 'No credit card required for the Free plan. Pro monthly includes a 7-day free trial — your card is only charged after the trial ends. Pro annual is paid upfront for $79 and does not include a trial.' }
    },
    {
      '@type': 'Question',
      name: 'Can I cancel anytime?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Cancel anytime from the customer portal. You keep access until the end of your billing period.' }
    },
    {
      '@type': 'Question',
      name: 'How is GeoScore different from closed-source GEO monitoring tools?',
      acceptedAnswer: { '@type': 'Answer', text: 'GeoScore is open-source (MIT): a CLI and MCP Server you can point at any LLM endpoint, plus prompt injection detection in the free browser audit. Closed-source monitoring suites are billed as monthly per-domain subscriptions and keep their scoring logic closed. They report what AI engines say about you; GeoScore audits what your site gives those engines to work with — 11 dimensions, with fix files you can apply yourself.' }
    },
    {
      '@type': 'Question',
      name: 'Do you handle VAT and taxes?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. As a Merchant of Record, our payment partner Creem handles VAT, GST, and sales tax compliance in 190+ countries.' }
    },
    {
      '@type': 'Question',
      name: 'Can you just do the fixes for me?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. The AI Visibility Fix Pack is a one-time $49 done-for-you service: a custom llms.txt built from your catalog, explicit AI-crawler rules for robots.txt, Product schema for one best-seller, a 1-page audit, and a re-audit after you deploy. Delivered in 48 hours via Fiverr Custom Offer, with a free diagnosis first.' }
    },
    {
      '@type': 'Question',
      name: 'Are Studio and Agency plans available?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Studio ($29/mo) and Agency ($59/mo) plans are available with 7-day free trials. They include higher audit frequencies, more domains, and team features.' }
    }
  ]
}}>
  <section class="max-w-5xl mx-auto py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
        Simple, <span class="gradient-text">transparent</span> pricing
      </h1>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Free forever for single audits. Upgrade when you need monitoring, history, or team features.
      </p>
    </div>

    <!-- Fix Pack: one-time done-for-you service, deliberately outside the subscription grid -->
    <div class="card p-6 md:p-8 mb-12 border-brand-500/30 flex flex-col md:flex-row md:items-center gap-6">
      <div class="flex-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">One-time · Done for you</div>
        <h2 class="text-2xl font-bold mb-2">AI Visibility Fix Pack — $49</h2>
        <p class="text-sm text-gray-400">
          Don't want to DIY? We rebuild your llms.txt from your real catalog, write explicit AI-crawler rules
          for robots.txt, and complete Product schema for your best-seller — then re-audit after you deploy.
          Human-made, checked against your live site, delivered in 48 hours.
        </p>
      </div>
      <div class="text-center shrink-0">
        <div class="text-4xl font-extrabold mb-1">$49</div>
        <div class="text-xs text-gray-500 mb-4">one-time · no subscription</div>
        <a id="fixpack-banner-cta" href="/fixpack/" class="inline-block px-6 py-3 rounded-xl font-semibold text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 transition">See what's included →</a>
      </div>
    </div>

    <!-- Global Billing Cycle Toggle -->
    <div class="flex justify-center mb-10">
      <div class="inline-flex items-center p-1 rounded-xl bg-gray-800/90 border border-gray-700/80 text-sm shadow-inner" role="group" aria-label="Billing cycle">
        <button type="button" id="billing-cycle-monthly" class="py-1.5 px-5 rounded-lg font-medium transition cursor-pointer bg-brand-500 text-white shadow-sm flex items-center gap-1.5">
          Monthly
        </button>
        <button type="button" id="billing-cycle-annual" class="py-1.5 px-5 rounded-lg font-medium transition cursor-pointer text-gray-400 hover:text-white flex items-center gap-2">
          Annual
          <span class="px-2 py-0.5 text-xs font-semibold bg-brand-500/20 text-brand-300 border border-brand-500/30 rounded-full">Save 25% on Pro</span>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-stretch mb-12">
      <!-- Free -->
      <div class="card p-5 lg:p-6 flex flex-col justify-between h-full relative">
        <!-- Area 1: Title and badge -->
        <div class="flex items-center justify-between mb-3 h-[28px]">
          <div class="text-base font-bold text-gray-200">Free</div>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-gray-800 text-gray-400 border border-gray-700">Hobby</span>
        </div>
        <!-- Area 2: Main price -->
        <div class="h-[44px] flex items-baseline mb-1">
          <span class="text-3xl font-extrabold text-white tracking-tight">$0</span>
          <span class="text-sm font-normal text-gray-400 ml-1.5">/ forever</span>
        </div>
        <!-- Area 3: Billing info -->
        <div class="h-[20px] mb-5 flex items-center text-xs text-gray-500">Free forever · Instant audit</div>
        <!-- Area 4: Features list (Standard 6 items, single-line alignment) -->
        <ul class="border-t border-gray-700/50 pt-5 mb-6 space-y-3 flex-1 text-xs md:text-[13px] text-gray-300">
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>Single URL instant audit</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>11 dimensions, 85 checks</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>Fix file generator</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>CLI & MCP Server tools</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>100% open-source (MIT)</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>Free forever, no card</span></li>
        </ul>
        <!-- Area 5: Action CTA button -->
        <div class="mt-auto">
          <a href="/#url-input" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 bg-gray-800/40 text-gray-300 hover:border-gray-500 hover:text-white transition">Start Free</a>
        </div>
      </div>

      <!-- Pro (Popular) -->
      <div class="card p-5 lg:p-6 flex flex-col justify-between h-full relative ring-2 ring-brand-500 bg-gradient-to-b from-brand-950/20 to-transparent shadow-lg shadow-brand-500/10">
        <!-- Area 1: Title and badge -->
        <div class="flex items-center justify-between mb-3 h-[28px]">
          <div class="text-base font-bold text-brand-400">Pro</div>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-brand-500/20 text-brand-400 border border-brand-500/40">Popular</span>
        </div>
        <!-- Area 2: Main price -->
        <div class="h-[44px] flex items-baseline mb-1">
          <span class="text-3xl font-extrabold text-white tracking-tight" id="pro-price-val">$9</span>
          <span class="text-sm font-normal text-gray-400 ml-1.5" id="pro-period-unit">/ mo</span>
        </div>
        <!-- Area 3: Billing info -->
        <div class="h-[20px] mb-5 flex items-center text-xs text-brand-400/90 font-medium whitespace-nowrap" id="pro-billing-note">7-day trial · Cancel anytime</div>
        <!-- Area 4: Features list (Standard 6 items, single-line alignment) -->
        <ul class="border-t border-brand-500/30 pt-5 mb-6 space-y-3 flex-1 text-xs md:text-[13px] text-gray-300">
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>Everything in Free</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>5 domains weekly audit</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>30-day history & alerts</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>Professional PDF export</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>AI estimate (30 runs/mo)</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-brand-500 font-bold shrink-0">✓</span><span>Priority email support</span></li>
        </ul>
        <!-- Area 5: Action CTA button -->
        <div class="mt-auto">
          <button id="upgrade-pro" type="button" data-plan="pro" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm text-white bg-gradient-to-r from-geo-600 to-brand-600 hover:from-geo-500 hover:to-brand-500 shadow-md shadow-brand-500/25 hover:shadow-brand-500/40 transition cursor-pointer">Start 7-Day Trial</button>
        </div>
      </div>

      <!-- Studio -->
      <div class="card p-5 lg:p-6 flex flex-col justify-between h-full relative border-geo-500/30">
        <!-- Area 1: Title and badge -->
        <div class="flex items-center justify-between mb-3 h-[28px]">
          <div class="text-base font-bold text-geo-400">Studio</div>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-geo-500/20 text-geo-400 border border-geo-500/40">Team</span>
        </div>
        <!-- Area 2: Main price -->
        <div class="h-[44px] flex items-baseline mb-1">
          <span class="text-3xl font-extrabold text-white tracking-tight">$29</span>
          <span class="text-sm font-normal text-gray-400 ml-1.5">/ mo</span>
        </div>
        <!-- Area 3: Billing info -->
        <div class="h-[20px] mb-5 flex items-center text-xs text-gray-500 whitespace-nowrap" id="studio-billing-note">7-day trial · Taxes included</div>
        <!-- Area 4: Features list (Standard 6 items, single-line alignment) -->
        <ul class="border-t border-gray-700/50 pt-5 mb-6 space-y-3 flex-1 text-xs md:text-[13px] text-gray-300">
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>Everything in Pro</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>15 domains daily audit</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>12-month history trends</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>Competitor benchmarks</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>Dedicated API access</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-geo-500 font-bold shrink-0">✓</span><span>Full audit data export</span></li>
        </ul>
        <!-- Area 5: Action CTA button -->
        <div class="mt-auto">
          <button id="upgrade-studio" type="button" data-plan="studio" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_yvmQsDZnoKHNXtDpJt51x" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 bg-gray-800/60 text-white hover:border-geo-500 hover:bg-geo-500/10 transition cursor-pointer">Start 7-Day Trial</button>
        </div>
      </div>

      <!-- Agency -->
      <div class="card p-5 lg:p-6 flex flex-col justify-between h-full relative border-indigo-500/30">
        <!-- Area 1: Title and badge -->
        <div class="flex items-center justify-between mb-3 h-[28px]">
          <div class="text-base font-bold text-indigo-400">Agency</div>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-500/20 text-indigo-400 border border-indigo-500/40">Enterprise</span>
        </div>
        <!-- Area 2: Main price -->
        <div class="h-[44px] flex items-baseline mb-1">
          <span class="text-3xl font-extrabold text-white tracking-tight">$59</span>
          <span class="text-sm font-normal text-gray-400 ml-1.5">/ mo</span>
        </div>
        <!-- Area 3: Billing info -->
        <div class="h-[20px] mb-5 flex items-center text-xs text-gray-500 whitespace-nowrap" id="agency-billing-note">7-day trial · Taxes included</div>
        <!-- Area 4: Features list (Standard 6 items, single-line alignment) -->
        <ul class="border-t border-gray-700/50 pt-5 mb-6 space-y-3 flex-1 text-xs md:text-[13px] text-gray-300">
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-indigo-500 font-bold shrink-0">✓</span><span>Everything in Studio</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-indigo-500 font-bold shrink-0">✓</span><span>50 domains hourly audit</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-indigo-500 font-bold shrink-0">✓</span><span>Unlimited audit history</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-indigo-500 font-bold shrink-0">✓</span><span>Client workspace isolation</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-indigo-500 font-bold shrink-0">✓</span><span>White-label PDF reports</span></li>
          <li class="flex items-center gap-2 h-[22px] whitespace-nowrap"><span class="text-indigo-500 font-bold shrink-0">✓</span><span>1-on-1 engineer support</span></li>
        </ul>
        <!-- Area 5: Action CTA button -->
        <div class="mt-auto">
          <button id="upgrade-agency" type="button" data-plan="agency" data-billing="monthly" data-checkout="https://www.creem.io/payment/prod_7Itt3xoxDKLaItFqjfhv7x" class="block w-full text-center py-2.5 rounded-lg font-semibold text-sm border border-gray-700 bg-gray-800/60 text-white hover:border-brand-500 hover:bg-brand-500/10 transition cursor-pointer">Start 7-Day Trial</button>
        </div>
      </div>
    </div>

    <!-- Comparison table -->
    <div class="card p-6 md:p-8 mb-12">
      <h2 class="text-xl font-bold mb-6 text-center">Feature Comparison</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-700">
              <th scope="col" class="text-left py-3 text-gray-400 font-medium">Feature</th>
              <th scope="col" class="text-center py-3 text-gray-400 font-medium">Free</th>
              <th scope="col" class="text-center py-3 text-brand-400 font-medium">Pro</th>
              <th scope="col" class="text-center py-3 text-geo-400 font-medium">Studio</th>
              <th scope="col" class="text-center py-3 text-gray-300 font-medium">Agency</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700/50">
            <tr><td class="py-2.5 text-gray-300">Single URL audit</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">11 dimensions, 85 checks</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">Fix file generator</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">CLI & MCP Server</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">Automated audits</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">Weekly</td><td class="text-center text-gray-300">Daily</td><td class="text-center text-gray-300">Hourly</td></tr>
            <tr><td class="py-2.5 text-gray-300">Audit history</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">30 days</td><td class="text-center text-gray-300">12 months</td><td class="text-center text-gray-300">Unlimited</td></tr>
            <tr><td class="py-2.5 text-gray-300">Regression alerts</td><td class="text-center text-gray-400">—</td><td class="text-center">✓</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">PDF export</td><td class="text-center text-gray-400">—</td><td class="text-center">✓</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">Competitor comparison</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">API access</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">Team workspace</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td></tr>
            <tr><td class="py-2.5 text-gray-300">White-label reports</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-400">—</td><td class="text-center text-gray-300">✓</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">Domains</td><td class="text-center text-gray-300">1</td><td class="text-center text-brand-400">5</td><td class="text-center text-geo-400">15</td><td class="text-center text-gray-300">50</td></tr>
            <tr class="font-semibold"><td class="py-2.5 text-white">Price</td><td class="text-center text-gray-300">$0</td><td class="text-center text-brand-400">$9/mo</td><td class="text-center text-geo-400">$29/mo</td><td class="text-center text-gray-300">$59/mo</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-6">Pricing FAQ</h2>
      <div class="space-y-4">
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Is GeoScore really free?</h3>
          <p class="text-sm text-gray-400">Single browser audits, the CLI, and the MCP Server are free. Sign-in is optional; Pro monitoring and history are paid. The source code is MIT-licensed on GitHub.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Do I need a credit card to start?</h3>
          <p class="text-sm text-gray-400">No credit card required for the Free plan. Pro monthly includes a 7-day free trial — your card is only charged after the trial ends. Pro annual is paid upfront for $79 and does not include a trial.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Can I cancel anytime?</h3>
          <p class="text-sm text-gray-400">Yes. Cancel anytime from the customer portal. You keep access until the end of your billing period.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">How is GeoScore different from closed-source GEO monitoring tools?</h3>
          <p class="text-sm text-gray-400">GeoScore is open-source (MIT): a CLI and MCP Server you can point at any LLM endpoint, plus prompt injection detection in the free browser audit. Closed-source monitoring suites are billed as monthly per-domain subscriptions and keep their scoring logic closed. They report what AI engines say about you; GeoScore audits what your site gives those engines to work with — 11 dimensions, with fix files you can apply yourself.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Do you handle VAT and taxes?</h3>
          <p class="text-sm text-gray-400">Yes. As a Merchant of Record, our payment partner Creem handles VAT, GST, and sales tax compliance in 190+ countries. You don't need to worry about tax forms.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Can you just do the fixes for me?</h3>
          <p class="text-sm text-gray-400">Yes. The <a href="/fixpack/" class="text-brand-400 hover:underline">AI Visibility Fix Pack</a> is a one-time $49 done-for-you service: a custom llms.txt built from your catalog, explicit AI-crawler rules for robots.txt, Product schema for one best-seller, a 1-page audit, and a re-audit after you deploy. Delivered in 48 hours via Fiverr Custom Offer, with a free diagnosis first.</p>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Are Studio and Agency plans available?</h3>
          <p class="text-sm text-gray-400">Yes. Studio ($29/mo) and Agency ($59/mo) plans are now live with 7-day free trials. They include daily/hourly automated audits, 15–50 domains, and team workspace capabilities.</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'GeoScore Pro',
    description: 'GEO audit tool with automated monitoring, regression alerts, and PDF export',
    brand: { '@type': 'Brand', name: 'GeoScore' },
    offers: [
      { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', price: '9', priceCurrency: 'USD', name: 'Pro monthly', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5' },
      { '@type': 'Offer', price: '79', priceCurrency: 'USD', name: 'Pro annual', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_2OZLydXjeAKD3HyVY20eEN' },
      { '@type': 'Offer', price: '29', priceCurrency: 'USD', name: 'Studio monthly', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_yvmQsDZnoKHNXtDpJt51x' },
      { '@type': 'Offer', price: '59', priceCurrency: 'USD', name: 'Agency monthly', availability: 'https://schema.org/InStock', url: 'https://www.creem.io/payment/prod_7Itt3xoxDKLaItFqjfhv7x' },
      { '@type': 'Offer', price: '49', priceCurrency: 'USD', name: 'AI Visibility Fix Pack (one-time service)', availability: 'https://schema.org/InStock', url: 'https://geoscore.help/fixpack/' }
    ]
  })} />
</Layout>

<script>
  import { showToast } from '../scripts/toast.js';
  // Pro / Studio / Agency checkout: each plan/period starts its Creem checkout.
  // The trial_started beacon fires right before navigation (API path and static fallback alike) so
  // the CTA -> checkout step is not lost when the browser leaves the page.
  async function startCheckout(btn) {
    const period = btn.getAttribute('data-billing') || 'monthly';
    const plan = btn.getAttribute('data-plan') || 'pro';
    const ctaId = btn.getAttribute('data-cta') || ('pricing_' + plan);
    const sourceType = window.geoSource ? window.geoSource() : 'other';
    if (window.geoTrack) {
      window.geoTrack('upgrade_cta_clicked', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType });
    }
    const token = localStorage.getItem('geoscore_token');
    if (!token) {
      // 2026-10-23: remember which plan they picked. The login flow reloads the
      // page, so without this the user had to find and click the price again.
      try {
        localStorage.setItem('geoscore_pending_checkout', JSON.stringify({ plan: plan, period: period, ts: Date.now() }));
      } catch (e) { /* storage blocked: the old double-click flow still works */ }
      if (window.geoscoreAuth) {
        window.geoscoreAuth.openAuthModal();
      } else {
        showToast('Please sign in first to start your free trial.', 'info');
      }
      return;
    }
    const successUrl = location.origin + '/pricing/?checkout=success';
    const leave = function (url) {
      if (window.geoTrack) {
        // transport_type beacon: the page unloads right after this, so the event
        // must survive on sendBeacon instead of a normal gtag round trip.
        // checkout_started marks the funnel step between CTA click and Creem:
        // without it, "clicked but never reached checkout" was invisible.
        window.geoTrack('checkout_started', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType, transport_type: 'beacon' });
        window.geoTrack('trial_started', { cta_id: ctaId, plan: plan, billing_period: period, source_type: sourceType, transport_type: 'beacon' });
      }
      window.location.href = url;
    };
    const fallbackUrl = btn.getAttribute('data-checkout');
    // Create a Creem checkout session bound to this account via the Worker;
    // fall back to the static checkout link if the API is unavailable.
    if (window.geoscoreAuth && window.geoscoreAuth.api) {
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = 'Preparing checkout...';
      try {
        const res = await window.geoscoreAuth.api('/api/checkout', { method: 'POST', body: { plan: plan, billing_period: period, success_url: successUrl } });
        if (res.ok && res.data && res.data.checkout_url) {
          leave(res.data.checkout_url);
          return;
        }
      } catch (e) {
        // Worker unreachable or timeout; fall through to the static link
      }
      btn.disabled = false;
      btn.innerHTML = original;
    }
    if (fallbackUrl) leave(fallbackUrl);
  }
  const planButtons = document.querySelectorAll('[data-billing]');
  for (let i = 0; i < planButtons.length; i++) {
    planButtons[i].addEventListener('click', function () { startCheckout(this); });
  }

  // Global Billing Cycle Toggle (Monthly / Annual)
  const btnMonthly = document.getElementById('billing-cycle-monthly');
  const btnAnnual = document.getElementById('billing-cycle-annual');
  const proPriceVal = document.getElementById('pro-price-val');
  const proPeriodUnit = document.getElementById('pro-period-unit');
  const proBillingNote = document.getElementById('pro-billing-note');
  const proBtn = document.getElementById('upgrade-pro');

  function setBillingCycle(cycle) {
    if (!proPriceVal || !proBtn) return;
    if (cycle === 'annual') {
      proPriceVal.textContent = '$79';
      if (proPeriodUnit) proPeriodUnit.textContent = '/ yr';
      if (proBillingNote) proBillingNote.textContent = 'Annual $79 · Save $29';
      proBtn.setAttribute('data-billing', 'annual');
      proBtn.setAttribute('data-checkout', 'https://www.creem.io/payment/prod_2OZLydXjeAKD3HyVY20eEN');
      proBtn.textContent = 'Subscribe Now';
      if (btnMonthly && btnAnnual) {
        btnAnnual.className = 'py-1.5 px-5 rounded-lg font-medium transition cursor-pointer bg-brand-500 text-white shadow-sm flex items-center gap-2';
        btnMonthly.className = 'py-1.5 px-5 rounded-lg font-medium transition cursor-pointer text-gray-400 hover:text-white flex items-center gap-1.5';
      }
    } else {
      proPriceVal.textContent = '$9';
      if (proPeriodUnit) proPeriodUnit.textContent = '/ mo';
      if (proBillingNote) proBillingNote.textContent = '7-day free trial · Cancel anytime';
      proBtn.setAttribute('data-billing', 'monthly');
      proBtn.setAttribute('data-checkout', 'https://www.creem.io/payment/prod_3hLh24EkJOL0jS0Jrf9zq5');
      proBtn.textContent = 'Start 7-Day Trial';
      if (btnMonthly && btnAnnual) {
        btnMonthly.className = 'py-1.5 px-5 rounded-lg font-medium transition cursor-pointer bg-brand-500 text-white shadow-sm flex items-center gap-1.5';
        btnAnnual.className = 'py-1.5 px-5 rounded-lg font-medium transition cursor-pointer text-gray-400 hover:text-white flex items-center gap-2';
      }
    }
  }

  if (btnMonthly) {
    btnMonthly.addEventListener('click', function () { setBillingCycle('monthly'); });
  }
  if (btnAnnual) {
    btnAnnual.addEventListener('click', function () { setBillingCycle('annual'); });
  }

  // Creem sends the buyer back here with ?checkout=success. Report it once per
  // session: a refresh must not re-report the same conversion.
  if (new URLSearchParams(location.search).get('checkout') === 'success') {
    let alreadyReported = false;
    try {
      alreadyReported = sessionStorage.getItem('geoscore_checkout_returned') === '1';
      if (!alreadyReported) sessionStorage.setItem('geoscore_checkout_returned', '1');
    } catch (e) { /* storage unavailable: report anyway rather than lose the event */ }
    if (!alreadyReported && window.geoTrack) {
      window.geoTrack('checkout_returned', {
        source_type: window.geoSource ? window.geoSource() : 'other',
        transport_type: 'beacon',
      });
    }
    // 2026-10-23: this used to fire an event and change nothing visible. A buyer
    // landed back on the same four plan cards with no confirmation that the
    // payment worked — the highest-intent moment in the funnel was a blank.
    renderCheckoutSuccess();
  }

  function renderCheckoutSuccess() {
    const host = document.querySelector('section');
    if (!host || document.getElementById('checkout-success')) return;
    const zh = (document.documentElement.lang || 'en').toLowerCase().indexOf('zh') === 0;
    const box = document.createElement('div');
    box.id = 'checkout-success';
    box.setAttribute('role', 'status');
    box.className = 'card p-6 mb-8 border-geo-500/40 bg-geo-500/10';
    box.innerHTML =
      '<h2 class="text-lg font-bold text-white mb-2">' +
        (zh ? '付款成功，订阅已生效' : 'Payment received — your subscription is active') +
      '</h2>' +
      '<p class="text-sm text-gray-300 mb-4">' +
        (zh
          ? '你的账号已升级。监控面板在首页，跑一次审计后即可看到监控、历史与 AI 可见度。'
          : 'Your account is upgraded. The monitoring panel lives on the home page — run one audit and monitoring, history and AI visibility open up.') +
      '</p>' +
      '<a href="/' + (zh ? 'zh/' : '') + '#pro-monitor-root" class="inline-block px-4 py-2 rounded-lg bg-geo-500 hover:bg-geo-600 text-white text-sm font-semibold transition">' +
        (zh ? '打开监控面板 →' : 'Open the monitoring panel →') +
      '</a>';
    host.insertBefore(box, host.firstChild);
  }

  // Resume a checkout that was interrupted by the sign-in flow. Both auth paths
  // in public/scripts/auth.js end with location.reload(), so the only reliable
  // place to continue is page load.
  (function resumePendingCheckout() {
    let pending = null;
    try {
      pending = JSON.parse(localStorage.getItem('geoscore_pending_checkout') || 'null');
      localStorage.removeItem('geoscore_pending_checkout');
    } catch (e) { return; }
    if (!pending || !pending.period) return;
    if (!localStorage.getItem('geoscore_token')) return;
    if (Date.now() - pending.ts > 10 * 60 * 1000) return;
    if (pending.plan === 'pro' && pending.period === 'annual') {
      setBillingCycle('annual');
    }
    const selector = pending.plan
      ? '[data-plan="' + pending.plan + '"][data-billing="' + pending.period + '"]'
      : '[data-billing="' + pending.period + '"]';
    const btn = document.querySelector(selector) || document.querySelector('[data-billing="' + pending.period + '"]');
    if (btn) startCheckout(btn);
  })();

  // Funnel instrumentation (2026-10-23 rebuild): the pricing page itself had no
  // view event, so the top of the paid funnel could not be measured at all.
  if (window.geoTrack) {
    window.geoTrack('pricing_viewed', { source_type: window.geoSource ? window.geoSource() : 'other' });
  }
  const fixpackCta = document.getElementById('fixpack-banner-cta');
  if (fixpackCta) {
    fixpackCta.addEventListener('click', function () {
      if (window.geoTrack) window.geoTrack('fixpack_cta_clicked', { placement: 'pricing_banner', transport_type: 'beacon' });
    });
  }
</script>
