---
import '../styles/global.css';
export interface Props {
  title?: string;
  schema?: object;
}
const { title = 'GeoScore - GEO Audit Tool', schema } = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Check your website visibility to AI search engines. Free GEO audit tool." />
  <meta name="author" content="GeoScore Team" />
  <link rel="author" href="https://geoscore.help/about" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Check your website GEO readiness score for AI search engines like ChatGPT, Perplexity, and Gemini." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://geoscore.help/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://geoscore.help/og-image.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="dns-prefetch" href="https://github.com" />
  <title>{title}</title>

  <!-- Google Analytics 4 — Measurement ID: G-98LLHZ0GDM -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-98LLHZ0GDM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-98LLHZ0GDM', { anonymize_ip: true });
  </script>
  <!-- GA4 track custom events -->
  <script is:inline>
    window.geoTrack = function(action, params) {
      if (typeof gtag === 'function') gtag('event', action, params || {});
    };
  </script>
  <!-- JSON-LD: Organization with sameAs (entity presence) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://geoscore.help/#organization',
    name: 'GeoScore',
    url: 'https://geoscore.help',
    logo: 'https://geoscore.help/og-image.png',
    description: 'Open-source GEO audit tool for AI search visibility.',
    sameAs: [
      'https://github.com/qq136692547-cmyk/geo-score',
      'https://github.com/qq136692547-cmyk/geo-optimization-handbook',
      'https://github.com/qq136692547-cmyk',
      'https://ttcalc.shop',
      'https://geoscore.help/about'
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'technical support',
      url: 'https://github.com/qq136692547-cmyk/geo-score/issues',
      email: 'qq136692547@gmail.com',
      availableLanguage: 'English'
    }
  })} />

  <!-- JSON-LD: WebSite (site-level entity + search action) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://geoscore.help/#website',
    url: 'https://geoscore.help',
    name: 'GeoScore',
    description: 'Free GEO audit tool — check your website visibility to AI search engines.',
    publisher: { '@id': 'https://geoscore.help/#organization' },
    inLanguage: 'en'
  })} />

  <!-- JSON-LD: Person (author) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://geoscore.help/#author',
    name: 'GeoScore Author',
    url: 'https://geoscore.help/about',
    jobTitle: 'GEO Researcher',
    worksFor: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    knowsAbout: ['Generative Engine Optimization', 'AI Search', 'llms.txt', 'Schema.org', 'Robots.txt', 'SEO', 'Web Development'],
    sameAs: [
      'https://github.com/qq136692547-cmyk'
    ]
  })} />

  <!-- JSON-LD: WebApplication (global) + page-specific schema via @graph -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ? {
    '@context': 'https://schema.org',
    '@graph': [schema, {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GeoScore',
    description: 'Free GEO audit tool — check your website visibility to AI search engines.',
    url: 'https://geoscore.help',
    applicationCategory: 'SEO Tool',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    features: ['12-dimension GEO scoring', 'AI search visibility audit', 'llms.txt checker', 'robots.txt AI crawler analysis', 'structured data audit', 'E-E-A-T signals'],
    author: { '@type': 'Person', name: 'GeoScore Team', url: 'https://geoscore.help/about' },
    publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    dateModified: '2026-08-11'    }]
  } : {
    '@context': 'https://schema.org',
    '@graph': [{
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GeoScore',
    description: 'Free GEO audit tool — check your website visibility to AI search engines.',
    url: 'https://geoscore.help',
    applicationCategory: 'SEO Tool',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    features: ['12-dimension GEO scoring', 'AI search visibility audit', 'llms.txt checker', 'robots.txt AI crawler analysis', 'structured data audit', 'E-E-A-T signals'],
    author: { '@type': 'Person', name: 'GeoScore Team', url: 'https://geoscore.help/about' },
    publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    dateModified: '2026-08-11'    }]
  })} />

</head>
<body class="min-h-[100dvh]">
  <header class="border-b border-gray-700/50 sticky top-0 z-50" style="background:rgba(15,23,42,0.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-x-4 min-h-16 py-2">
        <a href="/" class="flex items-center gap-2 text-xl font-bold hover:opacity-80 transition">
          <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="2" class="text-geo-500"/>
            <path d="M10 20 Q16 8 22 20" stroke="currentColor" stroke-width="2.5" fill="none" class="text-brand-500"/>
            <circle cx="14" cy="18" r="1.5" fill="currentColor" class="text-geo-500"/>
            <circle cx="18" cy="18" r="1.5" fill="currentColor" class="text-geo-500"/>
          </svg>
          <span class="gradient-text">GeoScore</span>
        </a>
        <input type="checkbox" id="en-nav-toggle" class="peer sr-only" />
        <label for="en-nav-toggle" class="md:hidden cursor-pointer text-gray-300 hover:text-white transition select-none text-2xl leading-none" aria-label="Menu">☰</label>
        <nav class="w-full hidden peer-checked:flex flex-col items-start gap-3 pt-3 pb-1 md:w-auto md:flex md:flex-row md:items-center md:gap-6 md:pt-0 md:pb-0 text-sm font-medium">
          <a href="/" class={"transition " + (path === "/" ? "text-brand-500" : "text-gray-300 hover:text-white")}>Home</a>
          <a href="/about" class={"transition " + (path === "/about" || path.startsWith("/about/") ? "text-brand-500" : "text-gray-300 hover:text-white")}>Methodology</a>
          <a href="/pricing" class={"transition " + (path === "/pricing" || path.startsWith("/pricing/") ? "text-brand-500" : "text-gray-300 hover:text-white")}>Pricing</a>
          <a href="/zh/" class="text-gray-300 hover:text-white transition" title="中文">中文</a>
          <a href="https://github.com/qq136692547-cmyk/geo-score" target="_blank" rel="noopener" class="text-gray-300 hover:text-white transition flex items-center gap-1.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-white/10 text-gray-400">v1.6.0</span>
          </a>
          <div id="nav-auth" class="ml-2"></div>
        </nav>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-[calc(100dvh-8rem)]">
    <slot />
  </main>

  <footer class="border-t border-gray-700/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-6">
        <div>
          <h4 class="text-sm font-bold text-white mb-3">Tools</h4>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href="/tools/llms-txt-checker" class="hover:text-brand-500 transition">llms.txt Checker</a></li>
            <li><a href="/tools/robots-txt-ai-checker" class="hover:text-brand-500 transition">Robots.txt AI Checker</a></li>
            <li><a href="/tools/ai-readiness-score" class="hover:text-brand-500 transition">AI Readiness Score</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-bold text-white mb-3">Learn</h4>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href="/blog/what-is-geo" class="hover:text-brand-500 transition">What is GEO?</a></li>
            <li><a href="/blog/geo-vs-seo" class="hover:text-brand-500 transition">GEO vs SEO</a></li>
            <li><a href="/blog/llms-txt-ultimate-guide" class="hover:text-brand-500 transition">llms.txt Ultimate Guide</a></li>
            <li><a href="/blog/ai-search-engine-list" class="hover:text-brand-500 transition">AI Search Engine List</a></li>
            <li><a href="/blog/json-ld-structured-data-ai-search" class="hover:text-brand-500 transition">JSON-LD for AI Search</a></li>
            <li><a href="/blog/eeat-signals-ai-search" class="hover:text-brand-500 transition">E-E-A-T for AI Search</a></li>
            <li><a href="/blog/geo-tracking-ai-visibility" class="hover:text-brand-500 transition">GEO Tracking Guide</a></li>
            <li><a href="/blog/why-doesnt-chatgpt-cite-my-website" class="hover:text-brand-500 transition">Why ChatGPT Doesn't Cite You</a></li>
            <li><a href="/about" class="hover:text-brand-500 transition">Methodology</a></li>
            <li><a href="https://github.com/qq136692547-cmyk/geo-optimization-handbook" target="_blank" rel="noopener" class="hover:text-brand-500 transition">GEO Handbook</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-bold text-white mb-3">Project</h4>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href="https://github.com/qq136692547-cmyk/geo-score" target="_blank" rel="noopener" class="hover:text-brand-500 transition">GitHub</a></li>
            <li><a href="/sitemap.xml" class="hover:text-brand-500 transition">Sitemap</a></li>
            <li><a href="/llms.txt" class="hover:text-brand-500 transition">llms.txt</a></li>
            <li><a href="/privacy" class="hover:text-brand-500 transition">Privacy</a></li>
            <li><a href="/terms" class="hover:text-brand-500 transition">Terms</a></li>
            <li><a href="mailto:qq136692547@gmail.com" class="hover:text-brand-500 transition">Support</a></li>
            <li><span class="text-gray-500">Open-source — MIT Licensed</span></li>
          </ul>
        </div>
      </div>
      <p class="text-xs text-gray-500 text-center">&copy; 2026 GeoScore. Powered by <a href="https://github.com/qq136692547-cmyk/geo-optimization-handbook" class="text-brand-500 hover:underline" target="_blank">GEO Optimization Handbook</a></p>
    </div>
  </footer>
  <script type="module" src="/scripts/auth.js"></script>
</body>
</html>
