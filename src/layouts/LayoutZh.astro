---
import '../styles/global.css';
export interface Props {
  title?: string;
  schema?: object;
}
const { title = 'GeoScore - GEO 审计工具', schema } = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="检测你的网站对 AI 搜索引擎的可见性。免费 GEO 审计工具。" />
  <meta name="author" content="GeoScore Team" />
  <link rel="author" href="https://geoscore.help/zh/about" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="检测你的网站对 ChatGPT、Perplexity、Claude、Gemini 等 AI 搜索引擎的 GEO 就绪分数。" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://geoscore.help/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://geoscore.help/og-image.png" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="dns-prefetch" href="https://github.com" />
  <title>{title}</title>

  <!-- Google Analytics 4 — Measurement ID: G-98LLHZ0GDM -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-98LLHZ0GDM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-98LLHZ0GDM');
  </script>
  <script is:inline>
    window.geoTrack = function(action, params) {
      if (typeof gtag === 'function') gtag('event', action, params || {});
    };
    function geoCrossSource() {
      try {
        const params = new URLSearchParams(location.search);
        const source = (params.get('utm_source') || '').toLowerCase();
        const medium = (params.get('utm_medium') || '').toLowerCase();
        if (source === 'ttcalc' && medium === 'site') return 'cross_site';
        if (source) return 'external';
        if (!document.referrer) return 'direct';
        const host = new URL(document.referrer).hostname.toLowerCase();
        if (/(^|\.)(google|bing|baidu|duckduckgo|yandex|ecosia|startpage|brave)\.[a-z.]+$/.test(host)) return 'search';
        return 'external';
      } catch (e) {
        return 'other';
      }
    }
    document.addEventListener('click', function(event) {
      const link = event.target.closest('a[data-cross-site]');
      if (!link || typeof window.geoTrack !== 'function') return;
      window.geoTrack('cross_site_click', { target_site: link.getAttribute('data-cross-site'), source_type: geoCrossSource() });
    });
  </script>

  <!-- JSON-LD: Organization (全站实体) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://geoscore.help/#organization',
    name: 'GeoScore',
    url: 'https://geoscore.help',
    logo: 'https://geoscore.help/og-image.png',
    description: '开源 GEO 审计工具，检测你的网站对 AI 搜索引擎的可见性。',
    sameAs: [
      'https://github.com/qq136692547-cmyk/geo-score',
      'https://github.com/qq136692547-cmyk/geo-optimization-handbook',
      'https://github.com/qq136692547-cmyk',
      'https://ttcalc.shop',
      'https://geoscore.help/zh/about'
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'technical support',
      url: 'https://github.com/qq136692547-cmyk/geo-score/issues',
      email: 'qq136692547@gmail.com',
      availableLanguage: 'Chinese'
    }
  })} />

  <!-- JSON-LD: WebSite (中文版) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://geoscore.help/zh/#website',
    url: 'https://geoscore.help/zh/',
    name: 'GeoScore - GEO 审计工具',
    description: '免费 GEO 审计工具 —— 检测你的网站对 AI 搜索引擎的可见性。',
    publisher: { '@id': 'https://geoscore.help/#organization' },
    inLanguage: 'zh-CN'
  })} />

  <!-- JSON-LD: Person (作者) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://geoscore.help/#author',
    name: 'GeoScore Author',
    url: 'https://geoscore.help/zh/about',
    jobTitle: 'GEO 研究员',
    worksFor: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
    knowsAbout: ['Generative Engine Optimization', 'AI 搜索', 'llms.txt', 'Schema.org', 'Robots.txt', 'SEO', 'Web 开发'],
    sameAs: [
      'https://github.com/qq136692547-cmyk'
    ]
  })} />

  <!-- JSON-LD: WebApplication (中文版全站) + 页面级 schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ? {
    '@context': 'https://schema.org',
    '@graph': [schema, {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'GeoScore',
      description: '免费 GEO 审计工具 —— 检测你的网站对 AI 搜索引擎的可见性。',
      url: 'https://geoscore.help/zh/',
      applicationCategory: 'SEO Tool',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      features: ['12 维度 GEO 评分', 'AI 搜索可见性审计', 'llms.txt 检测', 'robots.txt AI 爬虫分析', '结构化数据审计', 'E-E-A-T 信号'],
      author: { '@type': 'Person', name: 'GeoScore Team', url: 'https://geoscore.help/zh/about' },
      publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
      dateModified: '2026-08-11'
    }]
  } : {
    '@context': 'https://schema.org',
    '@graph': [{
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'GeoScore',
      description: '免费 GEO 审计工具 —— 检测你的网站对 AI 搜索引擎的可见性。',
      url: 'https://geoscore.help/zh/',
      applicationCategory: 'SEO Tool',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      features: ['12 维度 GEO 评分', 'AI 搜索可见性审计', 'llms.txt 检测', 'robots.txt AI 爬虫分析', '结构化数据审计', 'E-E-A-T 信号'],
      author: { '@type': 'Person', name: 'GeoScore Team', url: 'https://geoscore.help/zh/about' },
      publisher: { '@type': 'Organization', name: 'GeoScore', url: 'https://geoscore.help' },
      dateModified: '2026-08-11'
    }]
  })} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body class="min-h-screen bg-gray-950 text-gray-100 antialiased">
  <header class="sticky top-0 z-50 bg-gray-950/80 backdrop-blur-md border-b border-gray-800/50">
    <nav class="max-w-6xl mx-auto px-4 py-3">
      <div class="flex flex-wrap items-center justify-between gap-x-4">
      <a href="/zh/" class="flex items-center gap-2 text-lg font-bold">
        <span class="text-geo-500">Geo</span><span class="text-brand-500">Score</span>
      </a>
        <input type="checkbox" id="zh-nav-toggle" class="peer sr-only" />
        <label for="zh-nav-toggle" class="md:hidden cursor-pointer text-gray-300 hover:text-white transition select-none text-2xl leading-none" aria-label="菜单">☰</label>
      <div class="w-full hidden peer-checked:flex flex-col gap-3 pt-3 pb-1 md:w-auto md:flex md:flex-row md:items-center md:gap-4 md:pt-0 md:pb-0 text-sm">
        <a href="/zh/tools/llms-txt-checker" class="text-gray-400 hover:text-white transition">llms.txt 检测</a>
        <a href="/zh/tools/robots-txt-ai-checker" class="text-gray-400 hover:text-white transition">Robots.txt 检测</a>
        <a href="/zh/tools/ai-readiness-score" class="text-gray-400 hover:text-white transition">AI 就绪评分</a>
        <a href="/zh/blog" class="text-gray-400 hover:text-white transition">博客</a>
        <a href="/zh/about" class="text-gray-400 hover:text-white transition">关于</a>
        <a href="/zh/pricing" class="text-gray-400 hover:text-white transition">定价</a>
        <a href="/" class="text-gray-500 hover:text-gray-300 transition text-xs">EN</a>
        <a href="https://github.com/qq136692547-cmyk/geo-score" target="_blank" rel="noopener" class="text-gray-500 hover:text-white transition flex items-center gap-1.5">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-white/10 text-gray-400">v1.8.0</span>
        </a>
      </div>
        <div id="nav-auth" class="ml-0 md:ml-2"></div>
      </div>
    </nav>
  </header>

  <main class="pb-20">
    <slot />
  </main>

  <footer class="border-t border-gray-800/50 py-8 px-4">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
      <div class="flex items-center gap-2">
        <span class="text-geo-500 font-bold">Geo</span><span class="text-brand-500 font-bold">Score</span>
        <span class="ml-2">v1.8.0 免费开源 GEO 审计工具</span>
      </div>
      <div class="flex gap-4">
        <a href="/zh/privacy" class="hover:text-gray-300 transition">隐私政策</a>
