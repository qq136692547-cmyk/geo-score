---
import '../styles/global.css';
export interface Props {
  title?: string;
  schema?: object;
}
const { title = 'GeoScore - GEO 审计工具', schema } = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="检测你的网站对 AI 搜索引擎的可见性。免费 GEO 审计工具。" />
  <meta name="author" content="GeoScore Team" />
  <link rel="author" href="https://geoscore.help/zh/about" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="检测你的网站对 ChatGPT、Perplexity、Claude、Gemini 等 AI 搜索引擎的 GEO 就绪分数。" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://geoscore.help/og-image.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://geoscore.help/og-image.svg" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="dns-prefetch" href="https://github.com" />
  <title>{title}</title>

  <!-- Google Analytics 4 — Measurement ID: G-98LLHZ0GDM -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-98LLHZ0GDM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-98LLHZ0GDM');
  </script>

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body class="min-h-screen bg-gray-950 text-gray-100 antialiased">
  <header class="sticky top-0 z-50 bg-gray-950/80 backdrop-blur-md border-b border-gray-800/50">
    <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/zh/" class="flex items-center gap-2 text-lg font-bold">
        <span class="text-geo-500">Geo</span><span class="text-brand-500">Score</span>
        <span class="ml-1 text-xs px-1.5 py-0.5 rounded bg-gray-800 text-gray-400 font-mono">v1.1.0</span>
      </a>
      <div class="flex items-center gap-4 text-sm">
        <a href="/zh/tools/llms-txt-checker" class="text-gray-400 hover:text-white transition">llms.txt 检测</a>
        <a href="/zh/tools/robots-txt-ai-checker" class="text-gray-400 hover:text-white transition">Robots.txt 检测</a>
        <a href="/zh/tools/ai-readiness-score" class="text-gray-400 hover:text-white transition">AI 就绪评分</a>
        <a href="/zh/blog" class="text-gray-400 hover:text-white transition">博客</a>
        <a href="/zh/about" class="text-gray-400 hover:text-white transition">关于</a>
        <a href="/" class="text-gray-500 hover:text-gray-300 transition text-xs">EN</a>
        <a href="https://github.com/qq136692547-cmyk/geo-score" target="_blank" rel="noopener" class="text-gray-500 hover:text-white transition">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </a>
      </div>
    </nav>
  </header>

  <main class="pb-20">
    <slot />
  </main>

  <footer class="border-t border-gray-800/50 py-8 px-4">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
      <div class="flex items-center gap-2">
        <span class="text-geo-500 font-bold">Geo</span><span class="text-brand-500 font-bold">Score</span>
        <span class="ml-2">v1.1.0 — 开源 GEO 审计工具</span>
      </div>
      <div class="flex gap-4">
        <a href="/zh/privacy" class="hover:text-gray-300 transition">隐私政策</a>
        <a href="/zh/terms" class="hover:text-gray-300 transition">使用条款</a>
        <a href="/zh/about" class="hover:text-gray-300 transition">关于</a>
        <a href="https://github.com/qq136692547-cmyk/geo-score" target="_blank" rel="noopener" class="hover:text-gray-300 transition">GitHub</a>
      </div>
    </div>
    <div class="max-w-6xl mx-auto mt-4 text-center text-xs text-gray-600">
      <p>© 2026 GeoScore. MIT 许可证. 用 ❤️ 为 AI 搜索时代构建.</p>
    </div>
  </footer>
</body>
</html>
